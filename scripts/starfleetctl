#
# starfleetctl — thin wrapper that execs the workspace starfleetctl binary,
# so the CLI is invoked the same way as the other fleet-coordination tools
# in scripts/.
#
# The binary lives at .starfleet-ai/bin/starfleetctl (a single clone under
# .starfleet-ai/, managed by ./starfleet-bootstrap). There is no longer a
# separate mpbt solution / _WORK_/starfleetctl clone.
#
# Usage: scripts/starfleetctl <subcommand> [args…]
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(git -C "$HERE" rev-parse --show-toplevel)"
BIN="$ROOT/.starfleet-ai/bin/starfleetctl"

if [ ! -x "$BIN" ]; then
    echo "starfleetctl: binary not built — run ./starfleet-bootstrap first" >&2
    exit 1
fi

exec env MPBT_WORKSPACE_ROOT="$ROOT" "$BIN" "$@"
