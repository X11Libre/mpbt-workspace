# dashboard — safe read/write/commit/push cycle for DASHBOARD.md.
#
# Delegates to `starfleetctl dashboard` (Go backend).
#
# Usage:
#   dashboard pull                sync local DASHBOARD.md with origin
#   dashboard show                print current DASHBOARD.md (implies pull)
#   dashboard write <file|->      replace DASHBOARD.md's content
#   dashboard commit -m "<msg>" [--no-push]
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/starfleetctl" dashboard "$@"
