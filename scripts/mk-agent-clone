#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Create (or refresh) a dedicated agent-owned clone for backport work on a
# release line, fully isolated from the user's hand-edited clone but SHARING
# its git object store (via alternates) to save disk and network.
#
# Why a separate clone and not a worktree: xx-make-pr.sh rewrites the
# rfc/backport-<rel> branch history and fetches. A worktree shares the ref
# store/config, so those rewrites would mutate the user's branch. A separate
# clone shares ONLY objects — refs, index, HEAD and config are independent.
#
# Usage:
#   mk-agent-clone <release>          # e.g. mk-agent-clone 25.2
#   mk-agent-clone <release> <name>   # extra agent clones for parallel agents
#
# Layout:
#   reference (user clone): _WORK_/xserver-<rel>/sources/xlibre/xserver
#   agent clone:            _WORK_/xserver-<rel>/agent/<name>/xserver   (gitignored)
#
set -euo pipefail

REL="${1:?usage: mk-agent-clone <release> [name]   (e.g. mk-agent-clone 25.2)}"
NAME="${2:-default}"

WS="$(cd "$(dirname "$0")/.." && pwd)"
REF="$WS/_WORK_/xserver-$REL/sources/xlibre/xserver"
DEST="$WS/_WORK_/xserver-$REL/agent/$NAME/xserver"
INCUBATOR="rfc/backport-$REL"

[ -d "$REF/.git" ] || { echo "mk-agent-clone: reference clone not found: $REF" >&2; exit 1; }

URL="$(git -C "$REF" remote get-url origin)"
UP_BRANCH="$(git -C "$REF" config make-pr.upstream-branch)"

# Reproduce the config mpbt set up in the reference clone, by COPYING whole
# config sections verbatim rather than re-encoding specific keys. xx-make-pr.sh
# reads several settings from the repo config (make-pr.upstream-remote /
# upstream-branch / reviewers / any future keys), and mpbt also customizes the
# remotes (origin.tagopt + namespaced tag refspec, and the `xorg` upstream
# remote). Copy `make-pr.*` and `remote.*` so the agent clone behaves identically.
copy_cfg_section() {
    local prefix="$1"   # extended-regexp anchored at start, e.g. 'make-pr\.'
    # drop any existing keys under the prefix in DEST so multi-valued keys
    # (e.g. remote.origin.fetch) don't accumulate duplicates.
    # NB: `git config --get-regexp` exits 1 when nothing matches — which is the
    # normal case for a fresh clone (no make-pr.* yet). The `|| true` keeps that
    # non-match from tripping `set -o pipefail` + `set -e` and aborting the whole
    # refresh (otherwise mk-agent-clone can never initialise a new clone).
    { git -C "$DEST" config --name-only --get-regexp "^${prefix}" 2>/dev/null || true; } \
        | sort -u | while IFS= read -r k; do
            git -C "$DEST" config --unset-all "$k" 2>/dev/null || true
        done
    # re-add every value from REF (NUL-delimited so spaces/newlines survive)
    { git -C "$REF" config --null --get-regexp "^${prefix}" 2>/dev/null || true; } \
        | while IFS= read -r -d '' entry; do
            key="${entry%%$'\n'*}"
            val="${entry#*$'\n'}"
            git -C "$DEST" config --add "$key" "$val"
        done
}

if [ -d "$DEST/.git" ]; then
    echo "mk-agent-clone: agent clone exists; fetching -> $DEST"
    git -C "$DEST" fetch origin --prune
else
    mkdir -p "$(dirname "$DEST")"
    # origin = real upstream (so PRs push to GitHub); objects borrowed from the
    # user's local clone via --reference (alternates) to save disk/bandwidth.
    # --reference-if-able (not --reference): the reference clones under
    # _WORK_/ are shallow (mpbt fetches a limited depth), and a shallow repo
    # can't be used as a --reference alternate (missing objects) — git just
    # errors out ("hat eine unvollständige Historie"/"reference repository
    # is shallow") instead of falling back. -if-able degrades gracefully to a
    # normal full clone from $URL in that case, at the cost of the
    # disk/bandwidth saving, instead of hard-failing every agent clone.
    git clone --reference-if-able "$REF" "$URL" "$DEST"
fi

# always (re)apply — idempotent, so a refresh repairs config drift too
copy_cfg_section 'make-pr\.'
copy_cfg_section 'remote\.'
git -C "$DEST" fetch origin --prune   # pick up namespaced tags / xorg remote per copied refspecs

# land on the shared incubator branch (track the remote one if it exists,
# otherwise fork it from the upstream release branch)
if git -C "$DEST" ls-remote --exit-code --heads origin "$INCUBATOR" >/dev/null 2>&1; then
    git -C "$DEST" checkout -B "$INCUBATOR" "origin/$INCUBATOR"
else
    git -C "$DEST" checkout -B "$INCUBATOR" "origin/$UP_BRANCH"
fi

UP_REMOTE="$(git -C "$DEST" config make-pr.upstream-remote)"
echo "mk-agent-clone: ready -> $DEST"
echo "  branch: $INCUBATOR   upstream: $UP_REMOTE/$UP_BRANCH"
echo "  objects shared from: $REF"
