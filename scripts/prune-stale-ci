#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Delete COMPLETED workflow runs that are outdated — runs whose head commit is
# no longer the tip of their branch (the branch was pushed again afterwards),
# so the run is dead history cluttering the Actions tab.
#
# Sibling of cancel-stale-ci, which CANCELS still-running stale runs. This one
# DELETES finished ones. Run cancel-stale-ci first if you also want to stop
# in-flight runs; this script only touches `status=completed` runs (you can't
# meaningfully delete a run that's still going).
#
# A run is removed in either of two cases:
#   * its branch still exists but its tip MOVED (head SHA != current tip), or
#   * its branch is GONE entirely — a clean 404 on the branch (deleted/renamed),
#     so every run that ever ran on it is stale by definition.
#
# DELETION IS IRREVERSIBLE — a deleted run and its logs are gone for good. So:
#   * dry-run by default (prints a per-branch summary; --delete to act),
#   * "branch moved" deletes ONLY when the tip is positively resolved AND
#     differs from the run's head SHA,
#   * "branch gone" deletes only on a clean 404; pass --keep-gone to spare those,
#   * if a tip lookup fails for ANY OTHER reason (rate limit, network, auth),
#     the whole script ABORTS rather than risk misclassifying live branches as
#     gone and deleting their runs.
#
# Pagination: `gh api --paginate` walks every page of the (potentially
# thousands-long) completed-runs list; branch-tip lookups are cached so each
# branch is resolved exactly once.
#
# Usage:
#   prune-stale-ci [--delete] [--keep-gone] [--verbose]
#                  [--branch <name>]... [--workflow <name>]...
#     --delete            actually delete (default: dry-run summary only)
#     --keep-gone         spare runs whose branch no longer exists (404);
#                         by default those are deleted too
#     --verbose, -v       list every stale run, not just the per-branch summary
#     --branch <name>     only consider runs on this head branch (repeatable)
#     --workflow <name>   only consider runs of this workflow name (repeatable)
# Env:
#   REPO   override repo (default X11Libre/xserver)
set -euo pipefail

REPO="${REPO:-X11Libre/xserver}"
DO_DELETE=0 KEEP_GONE=0 VERBOSE=0
declare -a BRANCH_FILTER=() WF_FILTER=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --delete)        DO_DELETE=1 ;;
        --keep-gone)     KEEP_GONE=1 ;;
        --verbose|-v)    VERBOSE=1 ;;
        --branch)   shift; BRANCH_FILTER+=("${1:?--branch needs a value}") ;;
        --workflow) shift; WF_FILTER+=("${1:?--workflow needs a value}") ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; /^set -euo/d'; exit 0 ;;
        *) echo "prune-stale-ci: unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
done

in_list() { local needle="$1"; shift; local x; for x in "$@"; do [ "$x" = "$needle" ] && return 0; done; return 1; }

# --- 1. collect every completed run (all pages) -----------------------------
JQ_ROW='.workflow_runs[] | [
    (.id|tostring), (.name // ""), (.head_branch // ""), .head_sha,
    (.head_repository.full_name // ""), .created_at, (.conclusion // "")
] | @tsv'

runs_tsv="$(
    gh api --paginate \
        "repos/$REPO/actions/runs?status=completed&per_page=100&exclude_pull_requests=false" \
        -q "$JQ_ROW" | LC_ALL=C sort -u
)"

if [ -z "$runs_tsv" ]; then
    echo "prune-stale-ci: no completed CI runs on $REPO." >&2
    exit 0
fi

# --- 2. resolve a branch's current tip, distinguishing 404 from real errors -
# Sets REPLY to the tip SHA, or "" for a clean 404 (branch gone). Aborts the
# whole script on any other failure so a transient error can't be mistaken for
# a deleted branch.
declare -A TIP_CACHE
resolve_tip() {  # $1 = head_repo  $2 = branch
    local key="$1|$2" err rc out
    if [ -n "${TIP_CACHE[$key]+set}" ]; then REPLY="${TIP_CACHE[$key]}"; return 0; fi
    if [ -z "$2" ]; then TIP_CACHE[$key]=""; REPLY=""; return 0; fi
    err="$(mktemp)"
    if out="$(gh api "repos/$1/commits/$2" -q '.sha' 2>"$err")"; then
        TIP_CACHE[$key]="$out"; REPLY="$out"; rm -f "$err"; return 0
    fi
    if grep -qiE 'not found|HTTP 404|no commit found' "$err"; then
        TIP_CACHE[$key]=""; REPLY=""; rm -f "$err"; return 0   # clean 404 -> gone
    fi
    echo "prune-stale-ci: ABORT — tip lookup for $1@$2 failed (not a 404):" >&2
    sed 's/^/  /' "$err" >&2; rm -f "$err"
    exit 1
}

# --- 3. classify each run; tally per branch ---------------------------------
declare -a DEL_IDS=()        # stale (branch moved) run ids
declare -a GONE_IDS=()       # runs whose branch is gone (404)
declare -A STALE_CNT KEEP_CNT GONE_CNT BR_TIP
scanned=0
while IFS=$'\t' read -r id name br sha hrepo created concl; do
    [ -n "$id" ] || continue
    if [ "${#BRANCH_FILTER[@]}" -gt 0 ] && ! in_list "$br" "${BRANCH_FILTER[@]}"; then continue; fi
    if [ "${#WF_FILTER[@]}"     -gt 0 ] && ! in_list "$name" "${WF_FILTER[@]}"; then continue; fi
    scanned=$((scanned+1))
    hrepo="${hrepo:-$REPO}"
    gkey="$hrepo|$br"
    resolve_tip "$hrepo" "$br"; tip="$REPLY"
    BR_TIP[$gkey]="$tip"
    if [ -z "$tip" ]; then
        GONE_IDS+=("$id"); GONE_CNT[$gkey]=$(( ${GONE_CNT[$gkey]:-0} + 1 ))
        [ "$VERBOSE" -eq 1 ] && printf 'GONE   run %-12s %-22s %-30s %s  (branch 404)\n' "$id" "${name:0:22}" "${br:0:30}" "${sha:0:9}"
    elif [ "$tip" != "$sha" ]; then
        DEL_IDS+=("$id"); STALE_CNT[$gkey]=$(( ${STALE_CNT[$gkey]:-0} + 1 ))
        [ "$VERBOSE" -eq 1 ] && printf 'STALE  run %-12s %-22s %-30s %s -> tip %s (%s)\n' "$id" "${name:0:22}" "${br:0:30}" "${sha:0:9}" "${tip:0:9}" "$concl"
    else
        KEEP_CNT[$gkey]=$(( ${KEEP_CNT[$gkey]:-0} + 1 ))
    fi
done <<< "$runs_tsv"

# --- 4. per-branch summary --------------------------------------------------
[ "$VERBOSE" -eq 1 ] && echo
echo "=== prune-stale-ci summary ($REPO) ==="
printf '%-32s %6s %6s %6s  %s\n' "branch (head-repo)" "stale" "keep" "gone" "current tip"
for gkey in $(printf '%s\n' "${!BR_TIP[@]}" | LC_ALL=C sort); do
    s=${STALE_CNT[$gkey]:-0}; k=${KEEP_CNT[$gkey]:-0}; g=${GONE_CNT[$gkey]:-0}
    [ "$s" -eq 0 ] && [ "$g" -eq 0 ] && continue   # nothing to prune here
    repo="${gkey%%|*}"; br="${gkey#*|}"
    label="$br"; [ "$repo" != "$REPO" ] && label="$br ($repo)"
    tip="${BR_TIP[$gkey]}"; tipdisp="${tip:0:9}"; [ -z "$tip" ] && tipdisp="(gone)"
    printf '%-32s %6s %6s %6s  %s\n' "${label:0:32}" "$s" "$k" "$g" "$tipdisp"
done

echo
echo "scanned $scanned completed run(s): ${#DEL_IDS[@]} stale (branch moved), ${#GONE_IDS[@]} on gone branches, keeping the rest."

# what we'll actually delete: branch-moved runs always, plus gone-branch runs
# unless --keep-gone.
declare -a TARGETS=("${DEL_IDS[@]}")
if [ "$KEEP_GONE" -eq 1 ]; then
    [ "${#GONE_IDS[@]}" -gt 0 ] && echo "(${#GONE_IDS[@]} run(s) on deleted/renamed branches kept — --keep-gone.)"
else
    TARGETS+=("${GONE_IDS[@]}")
fi

if [ "${#TARGETS[@]}" -eq 0 ]; then
    echo "Nothing to delete. ✅"
    exit 0
fi

if [ "$DO_DELETE" -ne 1 ]; then
    echo "Dry run — nothing deleted. Re-run with --delete to remove the ${#TARGETS[@]} run(s) above. (irreversible)"
    exit 0
fi

# --- 5. delete --------------------------------------------------------------
ok=0 fail=0
for id in "${TARGETS[@]}"; do
    if gh api --method DELETE "repos/$REPO/actions/runs/$id" >/dev/null 2>&1; then
        ok=$((ok+1))
    else
        echo "WARN: could not delete run $id" >&2; fail=$((fail+1))
    fi
done
echo "prune-stale-ci: deleted $ok/${#TARGETS[@]} run(s)$( [ "$fail" -gt 0 ] && echo " ($fail failed)")."
exit 0
