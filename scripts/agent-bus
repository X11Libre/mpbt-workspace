# agent-bus — file-based status + directive bus for coordinating many
# independent agent sessions. Delegates to `starfleetctl agent-bus` (Go backend,
# same _WORK_/agent-bus/ file format + flock domain as this script's former bash
# body — see the package doc in internal/agentbus/agentbus.go).
#
# Commands:
#   agent-bus status <state> ["note"]   report/refresh my heartbeat
#   agent-bus inbox                      directives addressed to me or to all, unacked
#   agent-bus ack <id> ["note"]          mark a directive handled
#   agent-bus ask "<q>" [--to <ctrl>] [--timeout <secs>]   ask the controller (blocks)
#   agent-bus clear                      drop my heartbeat (session end)
#   agent-bus touch                      refresh my heartbeat's timestamp only
#   agent-bus board                      the whole board
#   agent-bus asks                       pending questions addressed to me
#   agent-bus reply <qid> <answer…>      answer a worker's question
#   agent-bus tell <agent> <text…>       queue a directive for one agent
#   agent-bus broadcast <text…>          queue a directive for ALL agents
#   agent-bus msgs                       list all directives with ack status
#   agent-bus events [N]                 tail the audit log (default 20)
#   agent-bus prune                      drop stale heartbeats + spent directives
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/starfleetctl" agent-bus "$@"
