#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Small JSON helper so agents stop reaching for ad-hoc `python3 -c "import json…"`
# one-liners (each of which triggers a fresh tool-authorization prompt, because
# arbitrary `python3 -c` can't be safely wildcard-allowlisted). This wrapper only
# ever reads/parses JSON, so it *can* be allowlisted — see .claude/settings.json.
#
# Reads from a file argument or from stdin (so `gh api … | scripts/json get …`
# works). Uses the stdlib json module under the hood.
#
# Usage:
#   json validate <file>...        parse each file; non-zero exit + message on invalid
#   json pretty [file]             pretty-print (indent=2) a file or stdin
#   json get <expr> [file]         evaluate a Python expression against the parsed
#                                  document (bound to `data`) and print the result;
#                                  reads the doc from [file] or stdin
#   json --help
#
# Examples:
#   scripts/json validate .claude/settings.json
#   scripts/json get "len(data['permissions']['allow'])" .claude/settings.json
#   gh api repos/X11Libre/xserver/issues/3229/labels | scripts/json get "[l['name'] for l in data]"
#   scripts/json pretty < some.json
#
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; s/^#$//' | sed '$d'; }

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 2; }
shift || true

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;

  validate)
    [ "$#" -ge 1 ] || { echo "json validate: need at least one file" >&2; exit 2; }
    rc=0
    for f in "$@"; do
      if err=$(python3 -c 'import json,sys
try:
    json.load(open(sys.argv[1]))
except Exception as e:
    sys.stderr.write(str(e)); sys.exit(1)' "$f" 2>&1); then
        echo "OK: $f"
      else
        echo "INVALID: $f -- $err" >&2
        rc=1
      fi
    done
    exit "$rc"
    ;;

  pretty)
    src="${1:-/dev/stdin}"
    python3 -c 'import json,sys; json.dump(json.load(open(sys.argv[1])), sys.stdout, indent=2, ensure_ascii=False); print()' "$src"
    ;;

  get)
    [ "$#" -ge 1 ] || { echo "json get: need an expression" >&2; exit 2; }
    expr="$1"; src="${2:-/dev/stdin}"
    python3 -c '
import json, sys
data = json.load(open(sys.argv[2]))
res = eval(sys.argv[1], {"__builtins__": __builtins__}, {"data": data, "json": json})
if isinstance(res, (dict, list)):
    print(json.dumps(res, ensure_ascii=False))
else:
    print(res)
' "$expr" "$src"
    ;;

  *)
    echo "json: unknown command '$cmd' (try --help)" >&2
    exit 2
    ;;
esac
