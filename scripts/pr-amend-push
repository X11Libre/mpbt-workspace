#!/usr/bin/env bash
#
# Fold working-tree changes into the current (PR head) commit of an agent clone
# and force-push (with lease) back to the PR branch — the second half of a PR
# repair started with scripts/pr-checkout.
#
# Keeps the PR a single clean commit: --amend --no-edit preserves the original
# author, message and Signed-off-by. --force-with-lease refuses to clobber the
# branch if someone else pushed since the clone last fetched it.
#
# (If you'd rather add a separate fixup commit instead of amending, just
# `git -C <clone> commit ...` and `git -C <clone> push` yourself — this script
# is the amend-into-one-commit convenience.)
#
# Usage:
#   pr-amend-push <clone-dir> [files...]
#     files...   paths (relative to the clone) to stage; default: all modified
#                tracked files (git add -u).
set -euo pipefail

DEST="${1:?usage: pr-amend-push <clone-dir> [files...]}"; shift || true
[ -d "$DEST/.git" ] || { echo "pr-amend-push: not a git clone: $DEST" >&2; exit 1; }

BR="$(git -C "$DEST" rev-parse --abbrev-ref HEAD)"
[ "$BR" != "HEAD" ] || { echo "pr-amend-push: clone is in detached HEAD — check out the PR branch first" >&2; exit 1; }

if [ "$#" -gt 0 ]; then
    git -C "$DEST" add -- "$@"
else
    git -C "$DEST" add -u
fi
git -C "$DEST" diff --cached --quiet && { echo "pr-amend-push: nothing staged — no changes to push" >&2; exit 1; }

git -C "$DEST" commit --amend --no-edit
git -C "$DEST" show --stat HEAD

# Push to the branch's configured remote, not a hard-coded origin: pr-checkout
# points fork PRs at a dedicated `fork` remote, while same-repo PRs track origin
# (the fallback keeps old behaviour). --force-with-lease uses that remote's
# tracking ref, so it still refuses to clobber an upstream that moved.
REMOTE="$(git -C "$DEST" config --get "branch.$BR.remote" || true)"
[ -n "$REMOTE" ] || REMOTE=origin
git -C "$DEST" push --force-with-lease "$REMOTE" "HEAD:$BR"
echo "pr-amend-push: force-pushed amended commit to '$REMOTE/$BR'" >&2
