#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Enumerate NVIDIA driver versions available on download.nvidia.com for an arch.
#
# Usage:
#   scripts/list-nvidia-versions               # every version (newest first)
#   scripts/list-nvidia-versions --per-branch  # only the latest of each major branch
#
# Env: NVIDIA_ARCH (default Linux-x86_64), NVIDIA_BASE.
#
set -euo pipefail

ARCH="${NVIDIA_ARCH:-Linux-x86_64}"
BASE="${NVIDIA_BASE:-https://download.nvidia.com/XFree86}"
per_branch=0
[ "${1:-}" = "--per-branch" ] && per_branch=1

# Scrape the autogenerated directory index (href='<version>/').
mapfile -t all < <(
    curl -fsS --max-time 60 "$BASE/$ARCH/" \
      | grep -oE "href='[0-9][^']*/'" \
      | sed -E "s/href='([^']*)\/'/\1/" \
      | sort -u
)
[ "${#all[@]}" -gt 0 ] || { echo "could not enumerate versions from $BASE/$ARCH/" >&2; exit 1; }

# version-sort newest-last; we print newest-first below
sort_versions() { printf '%s\n' "$@" | sort -V; }

if [ "$per_branch" = 1 ]; then
    # major branch = leading number before the first dot (390, 470, 550, 580, ...);
    # for each, keep the highest version. Legacy "1.0-NNNN" collapse under branch "1".
    declare -A latest
    while IFS= read -r v; do
        br="${v%%.*}"
        latest["$br"]="$v"   # last wins; input is ascending version-sorted
    done < <(sort_versions "${all[@]}")
    sort_versions "${latest[@]}" | tac
else
    sort_versions "${all[@]}" | tac
fi
