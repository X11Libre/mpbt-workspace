#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Cancel still-running CI runs that have been superseded — i.e. their branch
# moved on (a newer commit was pushed) since the run started, so the run is
# burning runner minutes on a commit nobody cares about anymore.
#
# GitHub only auto-cancels superseded runs when a workflow declares a
# `concurrency:` group; runs without one pile up. This is the maintainer broom
# for that: it finds every active (queued / in_progress / waiting / requested /
# pending) run and cancels the ones whose head commit is no longer the tip of
# their branch.
#
# How "outdated" is decided, per run:
#   1. Resolve the branch's CURRENT tip SHA (in the run's head repo — works for
#      fork PRs too). If run.head_sha != tip  -> outdated. This is the precise
#      "branch was updated in the meantime" signal.
#   2. If the tip can't be resolved (fork deleted/private, branch gone, etc.)
#      fall back to supersession among the active runs themselves: within a
#      (workflow, head-repo, branch) group keep the newest by created_at and
#      mark the rest outdated.
#
# Pagination is handled: `gh api --paginate` walks every page of the runs list
# (a busy repo easily exceeds one 100-item page), and branch-tip lookups are
# cached so each branch is resolved once regardless of how many runs share it.
#
# DRY-RUN BY DEFAULT: prints what it *would* cancel and exits. Pass --cancel
# (or -y) to actually cancel. Cancelling is cheap to undo — just re-run the job
# on GitHub — but it's a bulk operation, so preview first.
#
# Usage:
#   cancel-stale-ci [--cancel|-y] [--branch <name>]... [--workflow <name>]...
#     --cancel, -y        actually cancel (default: dry-run preview only)
#     --branch <name>     only consider runs on this head branch (repeatable)
#     --workflow <name>   only consider runs of this workflow name (repeatable)
# Env:
#   REPO   override repo (default X11Libre/xserver)
set -euo pipefail

REPO="${REPO:-X11Libre/xserver}"
DO_CANCEL=0
declare -a BRANCH_FILTER=() WF_FILTER=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --cancel|-y) DO_CANCEL=1 ;;
        --branch) shift; BRANCH_FILTER+=("${1:?--branch needs a value}") ;;
        --workflow) shift; WF_FILTER+=("${1:?--workflow needs a value}") ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; /^set -euo/d'; exit 0 ;;
        *) echo "cancel-stale-ci: unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
done

in_list() { local needle="$1"; shift; local x; for x in "$@"; do [ "$x" = "$needle" ] && return 0; done; return 1; }

# --- 1. collect every active run (all pages, all active states) -------------
# One NDJSON-ish TSV line per run. Fields chosen to be tab/newline-safe (title
# is sanitised). Active states per the GitHub status filter vocabulary.
ACTIVE_STATES="queued in_progress waiting requested pending"
JQ_ROW='.workflow_runs[] | [
    (.id|tostring), (.name // ""), (.head_branch // ""), .head_sha,
    (.head_repository.full_name // ""), .created_at, (.event // ""), .html_url,
    ((.display_title // "") | gsub("[\t\n\r]";" "))
] | @tsv'

runs_tsv="$(
    for st in $ACTIVE_STATES; do
        gh api --paginate \
            "repos/$REPO/actions/runs?status=$st&per_page=100&exclude_pull_requests=false" \
            -q "$JQ_ROW"
    done | LC_ALL=C sort -u
)"

if [ -z "$runs_tsv" ]; then
    echo "cancel-stale-ci: no active CI runs on $REPO." >&2
    exit 0
fi

# --- 2. load rows into arrays, applying branch/workflow filters -------------
declare -a R_ID R_WF R_BR R_SHA R_REPO R_CREATED R_EVENT R_URL R_TITLE
declare -A TIP                 # "repo|branch" -> current tip sha (or "?")
declare -A GROUP_NEWEST        # "wf|repo|branch" -> newest created_at seen
n=0
while IFS=$'\t' read -r id name br sha hrepo created event url title; do
    [ -n "$id" ] || continue
    if [ "${#BRANCH_FILTER[@]}" -gt 0 ] && ! in_list "$br" "${BRANCH_FILTER[@]}"; then continue; fi
    if [ "${#WF_FILTER[@]}"     -gt 0 ] && ! in_list "$name" "${WF_FILTER[@]}"; then continue; fi
    R_ID[n]="$id";   R_WF[n]="$name";  R_BR[n]="$br";   R_SHA[n]="$sha"
    R_REPO[n]="${hrepo:-$REPO}"; R_CREATED[n]="$created"; R_EVENT[n]="$event"
    R_URL[n]="$url"; R_TITLE[n]="$title"
    gkey="${name}|${R_REPO[n]}|${br}"
    if [ -z "${GROUP_NEWEST[$gkey]:-}" ] || [[ "$created" > "${GROUP_NEWEST[$gkey]}" ]]; then
        GROUP_NEWEST[$gkey]="$created"
    fi
    n=$((n+1))
done <<< "$runs_tsv"

[ "$n" -gt 0 ] || { echo "cancel-stale-ci: no active runs matched the filters." >&2; exit 0; }

# --- 3. resolve each branch's current tip once (cached) ---------------------
for ((i=0; i<n; i++)); do
    key="${R_REPO[i]}|${R_BR[i]}"
    [ -n "${TIP[$key]:-}" ] && continue
    if [ -z "${R_BR[i]}" ]; then TIP[$key]="?"; continue; fi
    tip="$(gh api "repos/${R_REPO[i]}/commits/${R_BR[i]}" -q '.sha' 2>/dev/null || true)"
    TIP[$key]="${tip:-?}"
done

# --- 4. classify outdated vs current ----------------------------------------
declare -a STALE_IDX=()
for ((i=0; i<n; i++)); do
    key="${R_REPO[i]}|${R_BR[i]}"
    tip="${TIP[$key]}"
    reason=""
    if [ "$tip" != "?" ]; then
        [ "$tip" != "${R_SHA[i]}" ] && reason="branch moved to ${tip:0:9}"
    else
        # tip unknown -> supersession fallback within the group
        gkey="${R_WF[i]}|${R_REPO[i]}|${R_BR[i]}"
        [ "${R_CREATED[i]}" != "${GROUP_NEWEST[$gkey]}" ] && reason="superseded (newer active run on branch)"
    fi
    if [ -n "$reason" ]; then
        STALE_IDX+=("$i")
        printf 'STALE  run %-12s %-22s %-28s %s @ %s\n      ↳ %s — %s\n' \
            "${R_ID[i]}" "${R_WF[i]:0:22}" "${R_BR[i]:0:28}" "${R_SHA[i]:0:9}" "${R_CREATED[i]}" \
            "$reason" "${R_URL[i]}"
    fi
done

if [ "${#STALE_IDX[@]}" -eq 0 ]; then
    echo "cancel-stale-ci: scanned $n active run(s); none are outdated. ✅"
    exit 0
fi

echo
echo "cancel-stale-ci: $n active run(s) scanned, ${#STALE_IDX[@]} outdated."

if [ "$DO_CANCEL" -ne 1 ]; then
    echo "Dry run — nothing cancelled. Re-run with --cancel (or -y) to cancel the above."
    exit 0
fi

# --- 5. cancel ---------------------------------------------------------------
fail=0
for i in "${STALE_IDX[@]}"; do
    if gh api --method POST "repos/$REPO/actions/runs/${R_ID[i]}/cancel" >/dev/null 2>&1; then
        echo "cancelled run ${R_ID[i]} (${R_BR[i]})"
    else
        echo "WARN: could not cancel run ${R_ID[i]} (already finishing?) — ${R_URL[i]}" >&2
        fail=$((fail+1))
    fi
done
echo "cancel-stale-ci: requested cancellation of $(( ${#STALE_IDX[@]} - fail ))/${#STALE_IDX[@]} run(s)."
exit 0
