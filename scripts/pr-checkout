#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Check out an open PR's head branch into an isolated, object-shared agent clone
# of the master line, ready to edit — for *repairing* an existing PR (e.g. a
# failing CI build / broken meson wiring), as opposed to *backporting* a merged
# PR (that's scripts/backport-commit).
#
# Why this and not editing in the user's clone: same isolation rule as backports
# — agents must never mutate the user's hand-edited sources clone. This reuses
# mk-agent-clone (origin = GitHub, objects borrowed via alternates), then checks
# out the PR's head branch so you can fix it and push back to the same branch.
#
# Pairs with scripts/pr-amend-push, which folds your edits into the PR's commit
# and force-pushes (with lease) to the same branch.
#
# Usage:
#   pr-checkout <pr#> [agent-name]      (agent-name default: "repair")
#
# On success prints the clone dir on stdout (so you can capture it); progress
# goes to stderr.
set -euo pipefail

WS="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS="$WS/scripts"

PR="${1:?usage: pr-checkout <pr#> [agent-name]}"; PR="${PR#\#}"
NAME="${2:-repair}"
DEST="$WS/_WORK_/xserver-master/agent/$NAME/xserver"

# Advisory cross-agent check (non-fatal): warn if another agent already claimed
# this PR, so two agents don't race on the shared PR branch. See pr-claim.
holder="$("$SCRIPTS/pr-claim" --who "$PR" 2>/dev/null || true)"
if [ -n "$holder" ]; then
    echo "pr-checkout: WARNING: PR #$PR is already claimed by another agent: $holder" >&2
    echo "pr-checkout: coordinate, pick another PR, or 'scripts/pr-claim --steal $PR' if that agent is gone." >&2
fi

# isolated master clone (object-shared); its `fetch origin --prune` already pulls
# every origin branch, including the PR head branch.
"$SCRIPTS/mk-agent-clone" master "$NAME" >&2

REPO="$(git -C "$DEST" config --get remote.origin.url \
        | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##')"

# Resolve the PR head: branch name, whether it lives on a fork (cross-repo), the
# fork's owner/repo, and whether maintainers may push to it. A same-repo PR has
# its head branch on origin; a fork PR does NOT, so `fetch origin <branch>` would
# fail — we wire a dedicated `fork` remote for those instead.
read -r BR CROSS FOWNER FREPO MCM < <(gh pr view "$PR" -R "$REPO" \
    --json headRefName,isCrossRepository,headRepositoryOwner,headRepository,maintainerCanModify \
    --jq '[.headRefName, .isCrossRepository, .headRepositoryOwner.login, .headRepository.name, .maintainerCanModify] | @tsv')
[ -n "${BR:-}" ] || { echo "pr-checkout: cannot resolve head branch for PR #$PR" >&2; exit 1; }

if [ "$CROSS" = "true" ]; then
    # Fork PR: its head branch is on the contributor's repo. Mirror origin's
    # transport (SSH/https) so pushing back reuses the same credentials — over
    # SSH that's the maintainer's key, no token needed. Push-back only works when
    # the PR has `allow edits from maintainers` (maintainerCanModify).
    FORK_URL="$(git -C "$DEST" config --get remote.origin.url \
        | sed -E "s#[^/:]+/[^/]+(\.git)?\$#$FOWNER/$FREPO.git#")"
    echo "pr-checkout: PR #$PR is from fork $FOWNER/$FREPO (branch '$BR') -> $FORK_URL" >&2
    [ "$MCM" = "true" ] || echo "pr-checkout: WARNING: maintainerCanModify is '$MCM' — push-back to the fork branch may be rejected." >&2
    git -C "$DEST" remote remove fork 2>/dev/null || true
    git -C "$DEST" remote add fork "$FORK_URL"
    git -C "$DEST" fetch fork "$BR" >&2
    git -C "$DEST" checkout -B "$BR" "fork/$BR" >&2   # tracks fork/<BR> -> pr-amend-push pushes there
    PUSH_REMOTE=fork
else
    git -C "$DEST" fetch origin "$BR" >&2
    git -C "$DEST" checkout -B "$BR" "origin/$BR" >&2
    PUSH_REMOTE=origin
fi

{
    echo "pr-checkout: PR #$PR head branch '$BR' checked out (push remote: $PUSH_REMOTE)."
    echo "  edit files in the clone, then:"
    echo "    scripts/pr-amend-push $DEST [files...]"
} >&2
echo "$DEST"
