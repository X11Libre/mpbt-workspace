# Serialize mutating git work within a single clone/working-tree, so that
# concurrent agent sessions and manual work don't clobber each other's
# checkout / index / rebase state.
#
# Delegates to `starfleetctl with-clone-lock` (Go backend).
#
# Usage:
#   with-clone-lock <command> [args...]   # run command while holding the lock
#   with-clone-lock                       # open a subshell holding the lock
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/starfleetctl" with-clone-lock "$@"
