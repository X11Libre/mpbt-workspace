#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Serialize mutating git work within a single clone/working-tree, so that
# concurrent agent sessions and manual work don't clobber each other's
# checkout / index / rebase state.
#
# Usage:
#   with-clone-lock <command> [args...]   # run command while holding the lock
#   with-clone-lock                       # open a subshell holding the lock
#
# Examples:
#   scripts/with-clone-lock scripts/xx-make-pr.sh <commit-sha>
#   scripts/with-clone-lock        # interactive shell; lock held until you exit
#
# Semantics:
#   - The lock is keyed to the per-worktree git dir (`git rev-parse
#     --absolute-git-dir`). Separate `git worktree`s of the same clone get
#     SEPARATE locks and therefore run in parallel; two actors in the SAME
#     working tree serialize.
#   - ADVISORY: it only protects against other actors that also go through
#     this wrapper. It can't stop a process that edits the tree directly.
#   - The lock auto-releases when the holding process exits (flock on an fd),
#     so there are no stale locks to clean up after a crash.
#   - Override the wait timeout with LOCK_WAIT (seconds, default 600).
#
set -euo pipefail

gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null)" || {
    echo "with-clone-lock: not inside a git working tree" >&2
    exit 1
}
lockfile="$gitdir/mpbt-clone.lock"

exec 9>"$lockfile"
if ! flock -w "${LOCK_WAIT:-600}" -x 9; then
    echo "with-clone-lock: could not acquire lock within ${LOCK_WAIT:-600}s" >&2
    echo "with-clone-lock: current holder ->" >&2
    cat "$lockfile" >&2 2>/dev/null || true
    exit 1
fi

# Record holder info for diagnostics (content is irrelevant to the lock itself).
printf 'pid=%s user=%s host=%s cmd=%s\n' \
    "$$" "${USER:-?}" "$(hostname 2>/dev/null || echo ?)" "${*:-<interactive shell>}" >"$lockfile"

if [ "$#" -eq 0 ]; then
    exec "${SHELL:-bash}"
fi
exec "$@"
