# agent-bus-monitor-loop — the Monitor-tool command that watches this session's
# own agent-bus inbox and prints one line per new/unacked directive, so Claude
# Code's Monitor tool surfaces them as in-context events instead of only a
# desktop notification. Delegates to `starfleetctl agent-bus monitor-loop`
# (Go backend).
#
# The Go backend implements the same surface as this script's former bash body:
# it prints `[<id>] from <from>: <text>` for each new message (backlog on the
# first iteration too) and periodically refreshes this ship's heartbeat via
# `touch` every $HEARTBEAT_INTERVAL (default 300s) so a long-running task that
# never calls `agent-bus status` itself doesn't fall out of $BUS_TTL and read as
# dead on the board. Per-directive auto-response (e.g. pong to Enterprise pings)
# is deliberately NOT done here — that's an AI decision and stays in the agent
# layer, not this mechanical loop.
#
# Usage: scripts/agent-bus-monitor-loop   (run via the Monitor tool, persistent: true)
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
AGENT_ID="${AGENT_ID:?agent-bus-monitor-loop: \$AGENT_ID is not set}"
exec "$HERE/starfleetctl" agent-bus monitor-loop
