#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Backport applicability check: for each maintained release line, fetch the
# given (master-path) file and grep it for a marker pattern, so you can
# classify each branch at a glance as vulnerable / already-fixed / N-A — the
# step the Backport workflow tells you to do first.
#
# Read-only: no clone, no mutation. Wraps show-branch-file, which fetches via
# the GitHub API and transparently resolves the Xext/<ext>/ <-> <ext>/ reorg
# between newer and older releases (it prints the path it actually used).
#
# Usage:
#   backport-applies <master-path> <grep-ERE> [release ...]
#     <master-path>  repo path as on master, e.g. Xext/glx/createcontext.c
#     <grep-ERE>     extended regex of markers to look for (buggy code AND/OR
#                    the fix), e.g. 'numAttribs \* 8|UINT32_MAX >> 3'
#     [release ...]  release lines to check (default: 25.2 25.1 25.0)
#
# Example:
#   backport-applies Xext/glx/createcontext.c 'numAttribs \* 8|UINT32_MAX >> 3'
set -euo pipefail

WS="$(cd "$(dirname "$0")/.." && pwd)"

PATH_IN="${1:?usage: backport-applies <master-path> <grep-ERE> [release ...]}"
ERE="${2:?usage: backport-applies <master-path> <grep-ERE> [release ...]}"
shift 2
RELS=("$@"); [ "${#RELS[@]}" -gt 0 ] || RELS=(25.2 25.1 25.0)

for r in "${RELS[@]}"; do
    echo "########## release/$r ##########"
    # show-branch-file prints the resolved path to stderr (flows to terminal),
    # the file body to stdout (captured here for grepping).
    if body="$("$WS/scripts/show-branch-file" "release/$r" "$PATH_IN")"; then
        printf '%s\n' "$body" | grep -nE "$ERE" || echo "  (no line matched: $ERE)"
    else
        echo "  file not found on release/$r ($PATH_IN)"
    fi
done
