#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Fetch the raw CI logs for a PR's failing jobs (or one job by id), and print a
# quick failure summary.
#
# Why a script: `gh run view --log` / `--log-failed` frequently return NOTHING
# on this repo, and the per-check annotations only say "Process completed with
# exit code 1". The reliable source is the per-job REST endpoint
#   repos/<repo>/actions/jobs/<id>/logs
# This wraps it: resolve the PR's failing jobs, download each full log to a
# file, then grep for the real cause across every phase a job can break in:
#   - build/link  : `FAILED:`, `ninja: build stopped`, `: error:`, `fatal error:`,
#                   `undefined reference`, `collect2: error:`, `cannot find -l`
#   - configure   : meson `meson.build:L:C: ERROR:`, `Dependency "x" not found`,
#                   `Run-time dependency ... found: NO`
#   - dep install : the distro package managers — Gentoo `emerge`/`!!!`, Alpine
#                   `apk`, Debian `E:`, Arch `target not found`, Fedora `No match`
#   - test phase  : meson `Summary of Failures` / `Fail: N` and `Caught signal` /
#                   `Segmentation fault` server crashes (a `xserver-build-*` job
#                   runs the XTS suite after building; see AGENTS.md)
# If NOTHING matches (an unanticipated failure mode), it falls back to printing
# the tail of the log so you always get context. Summary output strips the
# timestamp prefix for readability; the saved log file keeps it.
#
# Usage:
#   pr-job-logs <pr#>            # download logs of every FAILING job of the PR
#   pr-job-logs <pr#> --all      # download logs of EVERY job (not just failing)
#   pr-job-logs --job <job-id>   # download one specific job log by id
#   pr-job-logs <pr#> --no-grep  # download only, skip the failure summary
# Output:
#   writes each log to $OUTDIR/job-<id>.log and prints the file paths.
# Env:
#   REPO    override repo (default X11Libre/xserver)
#   OUTDIR  directory for the log files (default: a fresh mktemp -d)
set -euo pipefail

REPO="${REPO:-X11Libre/xserver}"
OUTDIR="${OUTDIR:-}"
PR=""
JOB_ID=""
WANT_ALL=0
DO_GREP=1

while [ "$#" -gt 0 ]; do
    case "$1" in
        --job)    shift; JOB_ID="${1:?--job needs a job id}" ;;
        --all)    WANT_ALL=1 ;;
        --no-grep) DO_GREP=0 ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; /^set -euo/d'; exit 0 ;;
        -*)       echo "pr-job-logs: unknown arg: $1" >&2; exit 2 ;;
        *)        PR="$1" ;;
    esac
    shift
done

[ -n "$OUTDIR" ] || OUTDIR="$(mktemp -d)"
mkdir -p "$OUTDIR"

# Resolve the list of job ids to fetch.
declare -a JOBS=()
if [ -n "$JOB_ID" ]; then
    JOBS=("$JOB_ID")
elif [ -n "$PR" ]; then
    # `gh pr checks` has no --json; parse its TSV text. Columns:
    # name <tab> state <tab> duration <tab> details-URL (.../runs/<r>/job/<id>).
    # It exits nonzero when a check is failing/pending, so guard with `|| true`.
    checks="$(gh pr checks "$PR" --repo "$REPO" 2>/dev/null || true)"
    if [ "$WANT_ALL" = 1 ]; then
        rows="$checks"
    else
        rows="$(printf '%s\n' "$checks" | awk -F'\t' '$2=="fail" || $2=="error"')"
    fi
    mapfile -t JOBS < <(
        printf '%s\n' "$rows" | grep -oE '/job/[0-9]+' | grep -oE '[0-9]+' | sort -u
    )
else
    echo "pr-job-logs: need a <pr#> or --job <id>" >&2; exit 2
fi

if [ "${#JOBS[@]}" -eq 0 ]; then
    echo "pr-job-logs: no matching jobs (PR #$PR — already green? use --all to fetch all)" >&2
    exit 1
fi

# Markers that identify the real cause, one per failure mode. Log lines are
# timestamp-prefixed (`2026-..Z <content>`); patterns that must sit at the start
# of the *content* anchor on `^<timestamp>` so they don't match the same token
# mid-line (e.g. a source line that merely contains "ERROR:" / "E:"). `Fail:`
# requires a nonzero count so the always-printed "Fail: 0" summary is ignored.
TS='^[0-9T:.Z[:space:]-]+'   # leading timestamp + indent, for content-anchored markers
MARKERS=(
    # build / link
    'FAILED:'
    'ninja: build stopped'
    ': error:'
    'fatal error:'
    'undefined reference to'
    'collect2: error:'
    'cannot find -l'
    "${TS}error:"
    # meson configure (NB: optional deps legitimately print "Run-time dependency
    # x found: NO" on a passing build, so that is NOT a failure marker; a *required*
    # miss shows up as the meson.build ERROR / `Dependency "x" not found` below)
    'meson\.build:[0-9]+:[0-9]+: ERROR:'
    'Dependency "[^"]*" not found'
    "${TS}ERROR: [A-Z]"
    # dep install — distro package managers
    'emerge: there are no ebuilds'
    "${TS}!!! "                       # portage error lines
    'ERROR: unable to select packages' # apk (alpine)
    "${TS}E: "                        # apt (debian/ubuntu)
    'error: target not found'          # pacman (arch)
    'No match for argument'            # dnf (fedora)
    # test phase
    'Summary of Failures'
    'Fail:[[:space:]]+[1-9]'
    'Caught signal'
    'Segmentation fault'
    # generic GitHub Actions
    'Process completed with exit code [1-9]'
)
GREP_RE="$(IFS='|'; printf '%s' "${MARKERS[*]}")"
# strip "<lineno>:<timestamp> " -> "<lineno>: " for readable summary lines
STRIP_TS='s/^([0-9]+):[0-9T:.Z+-]*Z /\1: /'

for id in "${JOBS[@]}"; do
    out="$OUTDIR/job-$id.log"
    if gh api "repos/$REPO/actions/jobs/$id/logs" > "$out" 2>/dev/null; then
        echo "$out"
    else
        echo "pr-job-logs: failed to fetch job $id" >&2
        continue
    fi
    [ "$DO_GREP" = 1 ] || continue
    echo "  --- summary (job $id) ---"
    matches="$(grep -nE "$GREP_RE" "$out" || true)"
    if [ -n "$matches" ]; then
        printf '%s\n' "$matches" | tail -25 | sed -E "$STRIP_TS" | sed 's/^/  /'
    else
        echo "  (no known failure markers matched — last 20 non-empty lines:)"
        grep -nE '.' "$out" | tail -20 | sed -E "$STRIP_TS" | sed 's/^/  /'
    fi
done
