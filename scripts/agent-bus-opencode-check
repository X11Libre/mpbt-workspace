#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# agent-bus-opencode-check — show new inbox messages since last check.
#
# Intended for opencode sessions which lack a Monitor tool. The assistant
# runs this at the start of each response (per AGENTS.md instruction) to
# surface new tell/broadcast directives and pending questions. Shares
# dedup state (monitor-seen/) with agent-bus-monitor-loop so messages seen
# by one are not re-shown by the other.
#
# Exit code always 0 (even with no messages) so it never blocks the
# assistant's turn.
set -euo pipefail

AGENT_ID="${AGENT_ID:-}"
[ -n "$AGENT_ID" ] || { echo "(agent-bus-opencode-check: AGENT_ID not set, skipping)"; exit 0; }

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUS_DIR="$ROOT/_WORK_/agent-bus"
MSG_DIR="$BUS_DIR/msgs"
ACK_DIR="$BUS_DIR/acks"
SEEN_DIR="$BUS_DIR/monitor-seen"
SEEN="$SEEN_DIR/$AGENT_ID"
AKS_DIR="$BUS_DIR/aks"

mkdir -p "$SEEN_DIR"
touch "$SEEN"

readarray -t seen_ids < "$SEEN"
declare -A seen_map
for sid in "${seen_ids[@]}"; do
    seen_map["$sid"]=1
done

new_messages=()
shopt -s nullglob
for f in "$MSG_DIR"/m*.tsv; do
    IFS=$'\t' read -r me te mf mt mtext < "$f" || continue
    id="$(basename "$f" .tsv)"
    [ "$mt" = all ] || [ "$mt" = "$AGENT_ID" ] || continue
    if [ ! -f "$ACK_DIR/${id}__${AGENT_ID}" ] && [ -z "${seen_map[$id]-}" ]; then
        new_messages+=("$id|$mf|$mtext")
        echo "$id" >> "$SEEN"
        seen_map["$id"]=1
    fi
done

pending_questions=()
if [ -d "$AKS_DIR" ]; then
    for f in "$AKS_DIR"/ask_*.tsv; do
        [ -f "$f" ] || continue
        IFS=$'\t' read -r qme qte qid qfrom qtext < "$f" || continue
        if [ "$qfrom" = "$AGENT_ID" ] && [ ! -f "$ACK_DIR/${qid}__${AGENT_ID}" ]; then
            pending_questions+=("$qid|$qtext")
        fi
    done
fi

if [ "${#new_messages[@]}" -gt 0 ]; then
    echo ""
    echo "## \U0001F4E8 New agent-bus messages"
    echo ""
    echo "| ID | From | Message |"
    echo "|----|------|---------|"
    for entry in "${new_messages[@]}"; do
        IFS='|' read -r id from text <<< "$entry"
        echo "| $id | $from | $text |"
    done
fi

if [ "${#pending_questions[@]}" -gt 0 ]; then
    echo ""
    echo "## \U00002753 Pending questions (asks)"
    echo ""
    for entry in "${pending_questions[@]}"; do
        IFS='|' read -r qid qtext <<< "$entry"
        echo "- **$qid**: $qtext"
    done
fi

if [ "${#new_messages[@]}" -eq 0 ] && [ "${#pending_questions[@]}" -eq 0 ]; then
    echo "(agent-bus inbox: nothing new)"
fi

exit 0
