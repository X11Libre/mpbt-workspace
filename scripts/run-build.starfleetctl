#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Build the starfleetctl Go binary and place it at the fixed location
# `.bin/starfleetctl` (a symlink to the built binary in the shared _WORK_
# checkout), so callers no longer need the old `.bin/starfleetctl` wrapper.
# The Go binary auto-detects the workspace root (walks up from cwd for
# AGENTS.md + scripts/), so no MPBT_WORKSPACE_ROOT env is required when
# invoked from anywhere inside the workspace tree.
#
# Usage: ./run-build.starfleetctl
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/_WORK_/starfleetctl/sources/xlibre/starfleetctl"
BIN="$SRC/starfleetctl"

cd "$SRC"
go build -o starfleetctl ./cmd/starfleetctl

mkdir -p "$ROOT/.bin"
ln -sf "$BIN" "$ROOT/.bin/starfleetctl"
