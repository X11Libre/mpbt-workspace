#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# worktree — create/list/remove throwaway git worktrees for ANY existing repo
# (not just the xserver release-line clones mk-agent-clone handles), for
# temporary / per-session / per-task isolation without a full clone.
#
# Why a worktree here (unlike mk-agent-clone, which deliberately avoids one):
# mk-agent-clone's reason for using a full clone is that xx-make-pr.sh
# REWRITES the shared incubator branch history — a worktree shares the ref
# store, so that rewrite would corrupt the reference clone's branch. A plain
# throwaway task/session worktree doesn't do that: it just needs its own
# working dir + index + HEAD on its OWN new branch, which is exactly what a
# worktree gives for a fraction of a clone's disk/setup cost. Don't use this
# for xserver backport/PR work (use mk-agent-clone there); use it for quick
# isolated edits, experiments, or parallel look-without-touching checkouts of
# any repo (mpbt-workspace itself, go-x11proto, flyingtux, ...).
#
# All worktrees live under THIS workspace's _WORK_/worktrees/ regardless of
# which repo they belong to, so they're in one well-known, already-gitignored
# place (_WORK_/ is the repo's only .gitignore entry) even for target repos
# that aren't mpbt-workspace-managed themselves.
#
# Usage:
#   worktree add <repo-path> [name] [--from <ref>] [--branch <existing-branch>]
#       Creates a new worktree. Default: a fresh branch `wt/<name>` branched
#       from <ref> (default: origin/HEAD, else the repo's current branch).
#       --branch <existing-branch> checks out that existing branch instead
#       (git refuses if it's already checked out elsewhere — same guard as
#       any other worktree).
#       <name> defaults to `wt-$$` (PID-based, unique per invocation).
#       Prints the resulting worktree path on its own stdout line.
#
#   worktree list [repo-path]
#       `git worktree list` for one repo, or every repo under _WORK_/worktrees
#       if no repo-path is given.
#
#   worktree remove <repo-path> <name> [--force] [--keep-branch]
#       Removes the worktree (git safety checks apply unless --force) and
#       deletes its `wt/<name>` branch unless --keep-branch or the worktree
#       was created with --branch (an existing branch is never deleted here).
#
#   worktree prune [repo-path]
#       `git worktree prune` (drops stale admin data for manually-deleted
#       worktree dirs), then removes now-empty leftover directories under
#       _WORK_/worktrees/<reponame>.
set -euo pipefail

WS="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$WS/_WORK_/worktrees"

usage() {
    cat >&2 <<'EOF'
usage: worktree add <repo-path> [name] [--from <ref>] [--branch <existing-branch>]
       worktree list [repo-path]
       worktree remove <repo-path> <name> [--force] [--keep-branch]
       worktree prune [repo-path]
EOF
    exit 2
}

repo_toplevel() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null \
        || { echo "worktree: not a git repo: $1" >&2; exit 1; }
}

[ $# -ge 1 ] || usage
cmd="$1"; shift

case "$cmd" in
    add)
        [ $# -ge 1 ] || usage
        repo="$(repo_toplevel "$1")"; shift
        name="wt-$$"
        from=""
        branch=""
        if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
            name="$1"; shift
        fi
        while [ $# -gt 0 ]; do
            case "$1" in
                --from)   from="${2:?--from needs a ref}"; shift 2;;
                --branch) branch="${2:?--branch needs a branch name}"; shift 2;;
                *) usage;;
            esac
        done

        reponame="$(basename "$repo")"
        dest="$ROOT/$reponame/$name"
        [ -e "$dest" ] && { echo "worktree: already exists: $dest" >&2; exit 1; }
        mkdir -p "$(dirname "$dest")"

        if [ -n "$branch" ]; then
            git -C "$repo" worktree add "$dest" "$branch"
        else
            [ -n "$from" ] || from="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD \
                || git -C "$repo" rev-parse --abbrev-ref HEAD)"
            git -C "$repo" worktree add -b "wt/$name" "$dest" "$from"
        fi
        echo "$dest"
        ;;

    list)
        if [ $# -ge 1 ]; then
            git -C "$(repo_toplevel "$1")" worktree list
        else
            [ -d "$ROOT" ] || { echo "worktree: no worktrees created yet"; exit 0; }
            find "$ROOT" -mindepth 2 -maxdepth 2 -type d | sort | while read -r wt; do
                git -C "$wt" rev-parse --show-toplevel >/dev/null 2>&1 || continue
                printf '%s\t%s\n' "$wt" "$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
            done
        fi
        ;;

    remove)
        [ $# -ge 2 ] || usage
        repo="$(repo_toplevel "$1")"; name="$2"; shift 2
        force=0
        keep_branch=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --force)       force=1; shift;;
                --keep-branch) keep_branch=1; shift;;
                *) usage;;
            esac
        done

        reponame="$(basename "$repo")"
        dest="$ROOT/$reponame/$name"
        [ -d "$dest" ] || { echo "worktree: no such worktree: $dest" >&2; exit 1; }

        rm_args=("$dest")
        [ "$force" = 1 ] && rm_args=(--force "$dest")
        git -C "$repo" worktree remove "${rm_args[@]}"

        if [ "$keep_branch" = 0 ] && git -C "$repo" show-ref --verify --quiet "refs/heads/wt/$name"; then
            git -C "$repo" branch -D "wt/$name"
        fi
        ;;

    prune)
        if [ $# -ge 1 ]; then
            repo="$(repo_toplevel "$1")"
            git -C "$repo" worktree prune -v
        elif [ -d "$ROOT" ]; then
            find "$ROOT" -mindepth 1 -maxdepth 1 -type d | while read -r reprootdir; do
                find "$reprootdir" -mindepth 1 -maxdepth 1 -type d | while read -r wt; do
                    git -C "$wt" rev-parse --show-toplevel >/dev/null 2>&1 && continue
                    echo "worktree: pruning stale dir (no longer a worktree): $wt"
                    rmdir "$wt" 2>/dev/null || true
                done
                rmdir "$reprootdir" 2>/dev/null || true
            done
        fi
        ;;

    *)
        usage
        ;;
esac
