#
# Append a text block to a PR's existing body (fetch -> append -> pr-set-body).
# Wraps the repeated read/append/write dance used for the required backport
# cross-linking: the "Backport dashboard" table appended to a master PR, and
# the back-link appended to each backport PR (see AGENTS.md's Backport
# workflow "Cross-linking" section).
#
# Usage:   pr-append-body <pr#> <text-file>
# Env:     REPO  override repo (default X11Libre/xserver)
set -euo pipefail

WS="$(cd "$(dirname "$0")/.." && pwd)"
REPO="${REPO:-X11Libre/xserver}"
PR="${1:?usage: pr-append-body <pr#> <text-file>}"
PR="${PR#\#}"
FILE="${2:?usage: pr-append-body <pr#> <text-file>}"

[ -f "$FILE" ] || { echo "pr-append-body: no such file: $FILE" >&2; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

gh api "repos/$REPO/pulls/$PR" --jq '.body' > "$TMP"
cat "$FILE" >> "$TMP"

REPO="$REPO" "$WS/scripts/pr-set-body" "$PR" "$TMP"
