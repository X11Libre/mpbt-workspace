#
# Request one or more reviewers on a PR via the REST API.
#
# Delegates to `starfleetctl pr-request-reviewers` (Go backend).
#
# Usage:   pr-request-reviewers <pr#> <login> [login...]
# Env:     REPO  override repo (default X11Libre/xserver)
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/starfleetctl" pr-request-reviewers "$@"
