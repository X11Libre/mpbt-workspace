#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# fleet-autoscale — spawn additional ships on demand when there's more
# parallelizable work queued than idle capacity on the board.
#
# Deliberately an EXPLICIT, on-demand trigger, not a background daemon: the
# caller (a human, or a control session like Enterprise) states how much
# parallel work it has right now via `need <N>`; nothing here polls the board
# or DASHBOARD.md on its own and decides to spawn ships unattended. That is a
# conscious design choice (see DASHBOARD.md's "fleet auto-scaling" entry) —
# auto-spawning costs real API tokens/resources per ship and is a
# higher-impact action than most bus directives, so it stays gated behind an
# explicit call. Nothing in this repo wires it into a Monitor loop, cron, or
# SessionStart hook — wiring up genuinely unattended operation is a separate,
# later step that needs sign-off first (see AGENTS.md/DASHBOARD.md).
#
# Usage:
#   fleet-autoscale need <N> --reason "<text>" [--release <rel>] [--client claude|opencode]
#                                    [--max <cap>] [--supervisor <name>]
#                                    [--permission-mode <mode>] [--dry-run]
#       Spawn up to <cap> minus the current non-stale fleet size, capped at
#       what's needed after subtracting currently-idle ships. Always prints a
#       decision and appends it to the audit log; an actual spawn also posts a
#       loud `agent-bus broadcast` — never a silent background action.
#   fleet-autoscale status [--max <cap>]
#       Show current fleet size / idle count / configured cap. No side effects.
#
# Worker tier: every spawned ship is tagged AGENT_TIER=worker and
#   AGENT_SUPERVISOR=<--supervisor, default "Enterprise"> (see agent-run and
#   agent-bus-boot-prompt) — no per-ship ownership/reassignment tracking, by
#   deliberate simplification (any control ship may address any free worker
#   ship; see DASHBOARD.md). For --client claude, --permission-mode (default
#   "dontAsk") is forwarded to `claude` so a blocked/rejected action fails
#   outright instead of prompting a confirmation nobody is there to answer —
#   the worker-tier boot prompt then tells it to report that failure to its
#   supervisor via `agent-bus tell` rather than hang or silently give up.
#   This required explicit maintainer sign-off before being wired up (agent-bus
#   m0051/m0066/2026-07-06) — see the DASHBOARD.md "Fleet auto-scaling" row.
#
# Hard cap: --max <cap> (default $FLEET_AUTOSCALE_MAX or 6) is a ceiling on the
#   TOTAL non-stale fleet size (idle+working+etc — not just ships this command
#   spawned), never exceeded regardless of <N>. Stale board entries (older
#   than agent-bus's own $BUS_TTL) don't count against it.
#
# Audit trail (gitignored): $WORK_DIR/agent-bus/autoscale-events.log — one
#   line per invocation, spawn AND no-op decisions alike, so "why did N new
#   ships appear" is always answerable without trusting the invoking agent's
#   own chat transcript (agent-bus messages aren't cryptographically
#   authenticated — see DASHBOARD.md's Parkplatz entry on that gap).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK_DIR="${WORK_DIR:-$ROOT/_WORK_}"
STATUS_DIR="$WORK_DIR/agent-bus/status"
BUS_TTL="${BUS_TTL:-900}"
AUDIT_LOG="$WORK_DIR/agent-bus/autoscale-events.log"
DEFAULT_MAX="${FLEET_AUTOSCALE_MAX:-6}"
AGENT_ID="${AGENT_ID:-$(id -un)@$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)}"

shopt -s nullglob

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; /^set -euo/d'; }
die()   { echo "fleet-autoscale: $*" >&2; exit 1; }

now()   { date +%s; }
isots() { date -Is 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ; }
mkdir -p "$(dirname "$AUDIT_LOG")"
audit() { printf '%s\t%s\t%s\n' "$(isots)" "$AGENT_ID" "$*" >>"$AUDIT_LOG"; }

# fleet_counts -> echoes "<total> <idle>" of non-stale board entries
fleet_counts() {
    local f e i a p s pid h n total=0 idle=0 t
    t="$(now)"
    for f in "$STATUS_DIR"/*.tsv; do
        IFS=$'\t' read -r e i a p s pid h n <"$f" || continue
        [ "$((t - e))" -ge "$BUS_TTL" ] && continue # stale, doesn't count
        total=$((total + 1))
        [ "$s" = "idle" ] && idle=$((idle + 1))
    done
    echo "$total $idle"
}

cmd="${1:-}"
if [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ]; then
    usage
    exit 0
fi
[ -n "$cmd" ] || {
    usage
    exit 1
}
shift

case "$cmd" in
status)
    max="$DEFAULT_MAX"
    while [ "$#" -ge 1 ]; do
        case "$1" in
        --max)
            shift
            max="${1:-$DEFAULT_MAX}"
            ;;
        *) die "unknown option: $1" ;;
        esac
        shift || true
    done
    read -r total idle < <(fleet_counts)
    echo "fleet-autoscale: $total ship(s) on board (non-stale), $idle idle, cap=$max"
    ;;

need)
    need="${1:-}"
    shift || true
    case "$need" in '' | *[!0-9]*) die "need: <N> must be a non-negative integer" ;; esac

    reason="" release="master" client="claude" max="$DEFAULT_MAX" dry=0
    supervisor="Enterprise" permission_mode="dontAsk"
    while [ "$#" -ge 1 ]; do
        case "$1" in
        --reason)
            shift
            reason="${1:-}"
            ;;
        --release)
            shift
            release="${1:-}"
            ;;
        --client)
            shift
            client="${1:-}"
            ;;
        --max)
            shift
            max="${1:-$DEFAULT_MAX}"
            ;;
        --supervisor)
            shift
            supervisor="${1:-Enterprise}"
            ;;
        --permission-mode)
            shift
            permission_mode="${1:-dontAsk}"
            ;;
        --dry-run) dry=1 ;;
        *) die "unknown option: $1" ;;
        esac
        shift || true
    done
    [ -n "$reason" ] || die 'need: --reason "..." is required (spawns must be auditable)'

    if [ -n "$release" ]; then
        rel_full="xserver-${release#xserver-}"
        [ -f "$ROOT/cf/$rel_full/config.sh" ] || die "no such release '$release' (missing cf/$rel_full/config.sh)"
    fi

    read -r total idle < <(fleet_counts)
    to_spawn=$((need > idle ? need - idle : 0))
    room=$((max > total ? max - total : 0))
    spawn=$((to_spawn < room ? to_spawn : room))

    if [ "$spawn" -le 0 ]; then
        if [ "$to_spawn" -eq 0 ]; then
            msg="no-op: $idle idle ship(s) already cover need=$need (fleet=$total/$max)"
        else
            msg="no-op: at/above cap (fleet=$total/$max, room=$room), NOT spawning $to_spawn needed ship(s) — raise --max or wait for a ship to free up"
        fi
        echo "fleet-autoscale: $msg"
        audit "need=$need reason=\"$reason\" $msg"
        exit 0
    fi

    echo "fleet-autoscale: spawning $spawn ship(s) (need=$need, idle=$idle, fleet=$total/$max) — reason: $reason"
    audit "need=$need reason=\"$reason\" spawning=$spawn fleet=$total/$max release=$release client=$client supervisor=$supervisor permission_mode=$permission_mode dry_run=$dry"

    if [ "$dry" -eq 1 ]; then
        echo "fleet-autoscale: --dry-run, not actually spawning"
        exit 0
    fi

    spawned=()
    for _ in $(seq 1 "$spawn"); do
        name="$("$ROOT/scripts/ship-names" assign)"
        run_args=("$release" --client "$client" --name "$name" --tier worker --supervisor "$supervisor")
        [ "$client" = "claude" ] && run_args+=(--permission-mode "$permission_mode")
        if ! "$ROOT/scripts/agent-run" "${run_args[@]}" >/dev/null; then
            "$ROOT/scripts/ship-names" release "$name" >/dev/null 2>&1 || true
            audit "spawn FAILED name=$name release=$release client=$client reason=\"$reason\""
            echo "fleet-autoscale: spawn failed for $name, releasing name, aborting remaining spawns" >&2
            break
        fi
        spawned+=("$name")
        audit "spawned name=$name release=$release client=$client supervisor=$supervisor permission_mode=$permission_mode reason=\"$reason\""
    done

    if [ "${#spawned[@]}" -gt 0 ]; then
        "$ROOT/scripts/agent-bus" broadcast "Auto-scale: spawned ${#spawned[@]} new worker ship(s) [${spawned[*]}] (release=$release, supervisor=$supervisor$([ "$client" = claude ] && echo ", permission-mode=$permission_mode")) — reason: $reason — triggered by $AGENT_ID, fleet now $((total + ${#spawned[@]}))/$max"
        echo "fleet-autoscale: spawned: ${spawned[*]}"
        for s in "${spawned[@]}"; do
            echo "  scripts/agent-attach $s"
        done
    else
        echo "fleet-autoscale: no ships spawned (all attempts failed)" >&2
        exit 1
    fi
    ;;

*)
    usage
    exit 1
    ;;
esac
