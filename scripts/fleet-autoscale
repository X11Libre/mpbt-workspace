# fleet-autoscale — spawn additional ships on demand when there's more
# parallelizable work queued than idle capacity on the board.
#
# Delegates to `starfleetctl session autoscale` (Go backend).  See
# `scripts/starfleetctl session autoscale --help`.
#
# Usage:
#   fleet-autoscale need <N> --reason "<text>" [--release <rel>] [--client claude|opencode]
#                                    [--max <cap>] [--supervisor <name>]
#                                    [--permission-mode <mode>] [--dry-run]
#   fleet-autoscale status [--max <cap>]
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"

[ "$#" -ge 1 ] || { exec "$HERE/starfleetctl" session autoscale; }
case "$1" in
    -h|--help) exec "$HERE/starfleetctl" session autoscale --help ;;
    *)         exec "$HERE/starfleetctl" session autoscale "$@" ;;
esac
