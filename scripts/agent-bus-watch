#!/usr/bin/env bash
#
# agent-bus-watch — local, LLM-free watcher that NOTIFIES when a new agent-bus
# directive arrives for this agent (explicit target or broadcast "all").
#
# It only reads the gitignored bus files, so it costs nothing (no API/LLM) until
# mail actually shows up. It is NOTIFY-ONLY: it does not act on or ack
# directives — it just tells you a new one landed, so you (or an active client)
# can pick it up. (Automatic handling may be added later, on explicit request.)
#
# Meant to be launched detached from a Claude Code SessionStart hook and stopped
# from SessionEnd, so it runs exactly while a client session is open — no daemon
# to babysit, nothing left running once the last client exits.
#
# Usage:
#   agent-bus-watch [interval]   watch for $AGENT_ID (default 15s poll)
#   agent-bus-watch --stop       stop the watcher for $AGENT_ID
#
# Identity: $AGENT_ID (falls back to user@host — export a unique one per session,
# see AGENTS.md "agent-bus"). Notifications go to:
#   - $BUS_DIR/notify/<agent>.log   append-only, tailable
#   - notify-send                    desktop popup, best-effort if a bus is reachable
# Each directive notifies once (deduped by id in $BUS_DIR/notify/.seen-<agent>).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUS_DIR="${BUS_DIR:-$ROOT/_WORK_/agent-bus}"
MSG_DIR="$BUS_DIR/msgs"
ACK_DIR="$BUS_DIR/acks"
NOTIFY_DIR="$BUS_DIR/notify"

AGENT_ID="${AGENT_ID:-$(id -un)@$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)}"
fsafe() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
AGENT_SAFE="$(fsafe "$AGENT_ID")"

PIDFILE="$NOTIFY_DIR/.watch-$AGENT_SAFE.pid"
SEENFILE="$NOTIFY_DIR/.seen-$AGENT_SAFE"
LOGFILE="$NOTIFY_DIR/$AGENT_SAFE.log"
mkdir -p "$NOTIFY_DIR"

stop() {
    if [ -f "$PIDFILE" ]; then
        local p; p="$(cat "$PIDFILE" 2>/dev/null || true)"
        [ -n "$p" ] && kill "$p" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
}

if [ "${1:-}" = "--stop" ]; then stop; exit 0; fi

INTERVAL="${1:-15}"

# One watcher per agent id: if a live one already runs, do nothing (lets several
# clients of the same agent share a single watcher).
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null || echo -1)" 2>/dev/null; then
    exit 0
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT
touch "$SEENFILE"

notify() {  # <id> <from> <text>
    local id="$1" from="$2" text="$3" ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '%s\t%s\tfrom %s\t%s\n' "$ts" "$id" "$from" "$text" >> "$LOGFILE"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal "agent-bus: directive for $AGENT_ID" "[$id] $from: $text" 2>/dev/null || true
    fi
}

while :; do
    shopt -s nullglob
    for f in "$MSG_DIR"/m*.tsv; do
        IFS=$'\t' read -r me te mf mt mtext < "$f" || continue
        id="$(basename "$f" .tsv)"
        [ "$mt" = all ] || [ "$mt" = "$AGENT_ID" ] || continue   # for me or broadcast
        [ -f "$ACK_DIR/${id}__${AGENT_SAFE}" ] && continue        # already acked
        grep -qxF "$id" "$SEENFILE" 2>/dev/null && continue       # already notified
        notify "$id" "$mf" "$mtext"
        echo "$id" >> "$SEENFILE"
    done
    sleep "$INTERVAL"
done
