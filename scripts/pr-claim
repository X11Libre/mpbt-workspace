#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# pr-claim — advisory, cross-clone PR work registry + lock.
#
# Each agent works in its OWN clone (see Concurrency in AGENTS.md), which keeps
# files / index / HEAD isolated. But every clone pushes to the SAME GitHub PR
# branch: two agents repairing the same PR would race on `pr-amend-push`
# (force-push clobber) and post duplicate review comments. This registry
# coordinates that — claim a PR before you mutate it; others see it's taken.
# It is also the shared "what is each agent working on" log (`--list`).
#
# ADVISORY ONLY: it coordinates actors that also use pr-claim (exactly like
# with-clone-lock, the single-working-tree companion to this). It cannot stop a
# raw `pr-amend-push` that skips the claim.
#
# Usage:
#   pr-claim <pr#> ["what you're doing"]   claim PR; exit 3 if held by another agent
#   pr-claim --list                        show all active claims (the work log)
#   pr-claim --release <pr#>               drop your claim on PR
#   pr-claim --release-all                 drop all claims held by this agent
#   pr-claim --steal <pr#> ["what"]        take over someone else's claim (logged)
#   pr-claim --who <pr#>                   print holder; exit 3 if held by another
#                                          (used by pr-checkout for a soft warning)
#
# Identity: $AGENT_ID — set a SHORT UNIQUE name per agent/session (e.g.
#   AGENT_ID=repair-3132). Without it, concurrent agents on the same host/user
#   share one identity and can't be told apart; the script warns when unset.
# Staleness: a claim older than $CLAIM_TTL seconds (default 3600) is reclaimable
#   without --steal (a warning + audit entry are emitted) — covers agents that
#   exited without releasing.
# Storage (gitignored): $CLAIM_DIR (default <workspace>/_WORK_/agent-claims/):
#   one pr-<N>.tsv per active claim + an append-only events.log audit trail.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLAIM_DIR="${CLAIM_DIR:-$ROOT/_WORK_/agent-claims}"
CLAIM_TTL="${CLAIM_TTL:-3600}"
if [ -n "${AGENT_ID:-}" ]; then AGENT_ID_SET=1; else AGENT_ID_SET=0; fi
AGENT_ID="${AGENT_ID:-$(id -un)@$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)}"
EVENTS="$CLAIM_DIR/events.log"

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; /^set -euo/d'; }

mkdir -p "$CLAIM_DIR"

now()   { date +%s; }
isots() { date -Is 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ; }
cfile() { printf '%s/pr-%s.tsv' "$CLAIM_DIR" "$1"; }
clean() { printf '%s' "${1:-}" | tr '\t\n' '  '; }
log_event() { printf '%s\t%s\t%s\t%s\n' "$(isots)" "$1" "$AGENT_ID" "$(clean "${2:-}")" >> "$EVENTS" 2>/dev/null || true; }
lock_registry() { exec 9>"$CLAIM_DIR/.lock"; flock 9; }

C_EPOCH=; C_ISO=; C_AGENT=; C_NOTE=
read_claim() {  # <pr> -> fills C_*; return 1 if no claim file
    local f; f="$(cfile "$1")"
    [ -f "$f" ] || return 1
    IFS=$'\t' read -r C_EPOCH C_ISO C_AGENT C_NOTE < "$f" || return 1
}
stale() { [ "$(( $(now) - ${1:-0} ))" -ge "$CLAIM_TTL" ]; }
age()   { local s=$(( $(now) - ${1:-0} ));
          if   [ "$s" -ge 3600 ]; then echo "$((s/3600))h$(((s%3600)/60))m";
          elif [ "$s" -ge 60   ]; then echo "$((s/60))m";
          else echo "${s}s"; fi; }
write_claim() { printf '%s\t%s\t%s\t%s\n' "$(now)" "$(isots)" "$AGENT_ID" "$(clean "${2:-}")" > "$(cfile "$1")"; }

warn_id() { [ "$AGENT_ID_SET" = 1 ] || echo "pr-claim: note: AGENT_ID not set; using '$AGENT_ID' — set a unique AGENT_ID per agent." >&2; }

do_list() {
    shopt -s nullglob
    local f found=0 e i a n s pr
    for f in "$CLAIM_DIR"/pr-*.tsv; do
        if [ "$found" = 0 ]; then printf '%-6s  %-24s  %-7s  %s\n' PR AGENT AGE WHAT; found=1; fi
        pr="$(basename "$f" .tsv)"; pr="${pr#pr-}"
        IFS=$'\t' read -r e i a n < "$f" || continue
        s=""; stale "$e" && s=" [STALE]"
        printf '%-6s  %-24s  %-7s  %s%s\n' "$pr" "$a" "$(age "$e")" "$n" "$s"
    done
    [ "$found" = 1 ] || echo "(no active claims)"
}

do_claim() {  # <pr> <note> <force>
    local pr="$1" note="${2:-}" force="${3:-0}"
    warn_id
    lock_registry
    if read_claim "$pr"; then
        if [ "$C_AGENT" = "$AGENT_ID" ]; then
            write_claim "$pr" "$note"; log_event refresh "pr#$pr $note"
            echo "pr-claim: refreshed your claim on PR #$pr"; return 0
        elif stale "$C_EPOCH"; then
            echo "pr-claim: reclaiming STALE claim on PR #$pr (was '$C_AGENT', age $(age "$C_EPOCH"))" >&2
            write_claim "$pr" "$note"; log_event reclaim-stale "pr#$pr from $C_AGENT"; return 0
        elif [ "$force" = 1 ]; then
            echo "pr-claim: STEALING PR #$pr from '$C_AGENT' (age $(age "$C_EPOCH"))" >&2
            write_claim "$pr" "$note"; log_event steal "pr#$pr from $C_AGENT"; return 0
        else
            echo "pr-claim: PR #$pr is held by '$C_AGENT' (age $(age "$C_EPOCH")): $C_NOTE" >&2
            echo "pr-claim: pick another PR, coordinate, or --steal if that agent is gone." >&2
            return 3
        fi
    fi
    write_claim "$pr" "$note"; log_event claim "pr#$pr $note"
    echo "pr-claim: claimed PR #$pr for '$AGENT_ID'"
}

do_release() {  # <pr>
    local pr="$1"
    lock_registry
    if read_claim "$pr"; then
        if [ "$C_AGENT" = "$AGENT_ID" ] || [ "${FORCE:-0}" = 1 ]; then
            rm -f "$(cfile "$pr")"; log_event release "pr#$pr"
            echo "pr-claim: released PR #$pr"
        else
            echo "pr-claim: PR #$pr is held by '$C_AGENT', not you ('$AGENT_ID'). Use FORCE=1 to override." >&2
            return 3
        fi
    else
        echo "pr-claim: no active claim on PR #$pr"
    fi
}

do_release_all() {
    lock_registry
    shopt -s nullglob
    local f e i a n cnt=0
    for f in "$CLAIM_DIR"/pr-*.tsv; do
        IFS=$'\t' read -r e i a n < "$f" || continue
        if [ "$a" = "$AGENT_ID" ]; then rm -f "$f"; cnt=$((cnt+1)); fi
    done
    log_event release-all "$cnt claims"
    echo "pr-claim: released $cnt claim(s) held by '$AGENT_ID'"
}

do_who() {  # <pr>: exit 0 if free/mine/stale; exit 3 + print holder if held by another active agent
    if read_claim "$1"; then
        { [ "$C_AGENT" = "$AGENT_ID" ] || stale "$C_EPOCH"; } && return 0
        echo "$C_AGENT (age $(age "$C_EPOCH")): $C_NOTE"
        return 3
    fi
    return 0
}

[ "$#" -ge 1 ] || { usage; exit 1; }
case "$1" in
    -h|--help)      usage ;;
    -l|--list)      do_list ;;
    --release)      shift; [ "$#" -ge 1 ] || { echo "pr-claim: --release needs <pr#>" >&2; exit 2; }; do_release "$1" ;;
    --release-all)  do_release_all ;;
    --steal)        shift; [ "$#" -ge 1 ] || { echo "pr-claim: --steal needs <pr#>" >&2; exit 2; }; do_claim "$1" "${2:-}" 1 ;;
    --who)          shift; [ "$#" -ge 1 ] || { echo "pr-claim: --who needs <pr#>" >&2; exit 2; }; do_who "$1" ;;
    --*)            echo "pr-claim: unknown option: $1" >&2; exit 2 ;;
    *)              do_claim "$1" "${2:-}" 0 ;;
esac
