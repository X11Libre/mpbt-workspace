#!/usr/bin/env bash
#
# Print a source file (or a function/symbol region) from the xserver repo at a
# given ref, WITHOUT needing a local clone — straight from the GitHub API.
#
# Built for backport applicability checks: inspect how a function looks on each
# release branch to decide whether a master fix applies, is already contained,
# or is N/A — the exact thing the Backport workflow tells you to do first.
#
# It transparently handles the directory reorg: master and 25.2 keep the
# extensions under Xext/<ext>/, while 25.1/25.0 (pre-reorg) keep them at
# <ext>/. If the given path 404s, it retries with a leading "Xext/" added or
# removed, and prints which path it actually used (to stderr).
#
# Usage:
#   show-branch-file <ref> <path> [symbol-grep-pattern]
#     <ref>      branch/tag/sha, e.g. release/25.2, master
#     <path>     repo path as on master, e.g. Xext/render/render.c
#     [symbol]   optional grep pattern; prints CONTEXT lines after the 1st hit
#
# Examples:
#   show-branch-file release/25.2 Xext/render/render.c 'ProcRenderSetPictureFilter(ClientPtr'
#   show-branch-file release/25.0 Xext/render/render.c 'ProcRenderSetPictureFilter(ClientPtr'
#
# Env:
#   REPO     override repo (default X11Libre/xserver)
#   CONTEXT  lines of context printed after a <symbol> hit (default 45)
set -euo pipefail

REPO="${REPO:-X11Libre/xserver}"
CONTEXT="${CONTEXT:-45}"

REF="${1:?usage: show-branch-file <ref> <path> [symbol]}"
PATH_IN="${2:?usage: show-branch-file <ref> <path> [symbol]}"
SYMBOL="${3:-}"

fetch_raw() { # <path> -> file content on stdout, nonzero exit if not found
    gh api "repos/$REPO/contents/$1?ref=$REF" -H "Accept: application/vnd.github.raw" 2>/dev/null
}

# try given path, then with the Xext/ prefix toggled (pre/post reorg layouts)
candidates=("$PATH_IN")
case "$PATH_IN" in
    Xext/*) candidates+=("${PATH_IN#Xext/}") ;;
    *)      candidates+=("Xext/$PATH_IN") ;;
esac

content="" used=""
for p in "${candidates[@]}"; do
    if content="$(fetch_raw "$p")"; then used="$p"; break; fi
done

[ -n "$used" ] || { echo "show-branch-file: not found on $REF: ${candidates[*]}" >&2; exit 1; }
echo "show-branch-file: $REPO@$REF :: $used" >&2

if [ -z "$SYMBOL" ]; then
    printf '%s\n' "$content"
else
    printf '%s\n' "$content" | grep -n -A "$CONTEXT" -e "$SYMBOL" \
        || { echo "show-branch-file: pattern not found: $SYMBOL" >&2; exit 2; }
fi
