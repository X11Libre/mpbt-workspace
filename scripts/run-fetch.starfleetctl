#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Fetch (clone or fast-forward) the starfleetctl Go source into the shared
# _WORK_ checkout. Mirrors the pattern of the other sister-project run-fetch.*
# scripts (go-x11proto, flyingtux) — starfleetctl is its own mpbt solution,
# NOT part of the xserver build.
#
# Usage: ./run-fetch.starfleetctl
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/_WORK_/starfleetctl/sources/xlibre/starfleetctl"

if [ -d "$SRC/.git" ]; then
    git -C "$SRC" fetch -q origin
    git -C "$SRC" merge --ff-only origin/master || true
else
    mkdir -p "$(dirname "$SRC")"
    git clone git@github.com:mpbt-hq/starfleetctl.git "$SRC"
fi
