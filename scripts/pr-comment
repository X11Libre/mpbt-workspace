#!/usr/bin/env bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Post a PR comment from a file. Plain wrapper around `gh pr comment
# --body-file`, with one addition: --bot-review prepends the exact banner
# AGENTS.md's "Automated reviews" section mandates on every review comment
# posted in the user's name, so the wording can't drift between call sites.
# The banner includes the executing session's ship name ($AGENT_ID) so a
# review comment is traceable to the specific agent/session that posted it.
#
# Usage:   pr-comment <pr#> <body-file> [--bot-review]
# Env:     REPO      override repo (default X11Libre/xserver)
#          AGENT_ID  ship name shown in the --bot-review banner (falls back
#                    to user@host if unset, same fallback as scripts/starfleetctl agent-bus)
#
# Examples:
#   pr-comment 3103 /tmp/reply.md                 # plain comment, no banner
#   pr-comment 3181 /tmp/review.md --bot-review    # bot-review outcome comment
set -euo pipefail

REPO="${REPO:-X11Libre/xserver}"
PR="${1:?usage: pr-comment <pr#> <body-file> [--bot-review]}"
PR="${PR#\#}"
FILE="${2:?usage: pr-comment <pr#> <body-file> [--bot-review]}"
BOT_REVIEW=0
[ "${3:-}" = "--bot-review" ] && BOT_REVIEW=1

[ -f "$FILE" ] || { echo "pr-comment: no such file: $FILE" >&2; exit 1; }

if [ "$BOT_REVIEW" -eq 1 ]; then
    SHIP="${AGENT_ID:-$(id -un)@$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)}"
    TMP="$(mktemp)"
    trap 'rm -f "$TMP"' EXIT
    {
        echo "> 🤖 **Automated review** — generated by Claude Code (ship: $SHIP) on behalf of @metux. Not a human review."
        echo
        cat "$FILE"
    } > "$TMP"
    FILE="$TMP"
fi

gh pr comment "$PR" --repo "$REPO" --body-file "$FILE"
