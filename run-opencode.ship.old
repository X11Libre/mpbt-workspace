#!/bin/bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Start an opencode session registered on the agent-bus board under
# its own AGENT_ID — the opencode counterpart to run-ship (which
# launches Claude Code). Gets a random Star Trek ship name assigned
# so it appears as a distinct crew member on `scripts/agent-bus board`.
#
# Usage:
#   ./run-opencode.ship [--release <rel>] [--name <id>] [-- <opencode args>]
#
#   --release <rel>   source that project's cf/<rel>/config.sh (exports
#                      XLIBRE_RELEASE) before starting opencode. <rel> accepts
#                      the same short/full forms as run-opencode.* (e.g.
#                      "master", "25.2", "xserver-25.2") as well as the
#                      non-xserver solutions ("flyingtux", "go-x11proto").
#   --name <id>       override AGENT_ID (default: reuse the shell's AGENT_ID
#                      if set, else next free ship name from scripts/ship-names,
#                      falling back to "ws-$$")
#

RELEASE=""
NAME=""
EXTRA=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --release) shift; RELEASE="${1:-}" ;;
        --name)    shift; NAME="${1:-}" ;;
        -h|--help)
            sed -n '3,/^RELEASE=/p' "$0" | sed 's/^# \{0,1\}//; /^RELEASE=/d'
            exit 0 ;;
        --) shift; EXTRA=("$@"); break ;;
        *) EXTRA+=("$1") ;;
    esac
    shift
done

if [ -n "$RELEASE" ]; then
    if [ -f "cf/$RELEASE/config.sh" ]; then
        cfg="cf/$RELEASE/config.sh"
    else
        cfg="cf/xserver-${RELEASE#xserver-}/config.sh"
    fi
    [ -f "$cfg" ] || { echo "run-opencode.ship: no such release/solution '$RELEASE' (missing $cfg)" >&2; exit 1; }
    . "$cfg"
    export XLIBRE_RELEASE
else
    unset XLIBRE_RELEASE 2>/dev/null || true
fi

# Reuse the shell's already-assigned AGENT_ID (e.g. from agent-bus-auto-id.sh)
# to avoid consuming two separate ship names for the same session.
if [ -n "${AGENT_ID:-}" ] && [ -z "$NAME" ]; then
    NAME="$AGENT_ID"
fi

if [ -z "$NAME" ]; then
    NAME="$(scripts/ship-names assign 2>/dev/null)" || true
    if [ -z "$NAME" ]; then
        NAME="ws-$$"
    fi
fi

export AGENT_ID="$NAME"

# Register initial heartbeat. opencode does NOT fire Claude Code's
# SessionStart/SessionEnd hooks, so we do it here. No exit cleanup is
# possible (exec replaces this shell) — agent-bus's TTL / prune reaps it.
scripts/agent-bus status idle "opencode ship" >/dev/null 2>&1 || true

# Auto-start monitor-loop and desktop-notify watcher in background
# (opencode has no Monitor tool). Logs land in _WORK_/agent-bus/logs/
# for later review.
LOGDIR="_WORK_/agent-bus/logs"
mkdir -p "$LOGDIR"
nohup scripts/agent-bus-monitor-loop >> "$LOGDIR/monitor-loop.log" 2>&1 &
nohup scripts/starfleetctl agent-bus watch >> "$LOGDIR/watch.log" 2>&1 &

export OPENCODE_CONFIG_CONTENT="{\"username\":\"${AGENT_ID}\"}"
exec opencode --prompt "Session just started for ship ${AGENT_ID:-unknown}. Check your inbox with 'scripts/agent-bus inbox'." "${EXTRA[@]+"${EXTRA[@]}"}"
