#!/bin/bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Start an opencode session for the xserver-master release line.
# Sets XLIBRE_RELEASE so subagents know which solution/workdir to use.
#

set -e

. cf/xserver-master/config.sh
cd "${WORKDIR}"
export XLIBRE_RELEASE

echo "WORKDIR=${WORKDIR}"
PROJECT_DIR=`pwd`

export GIT_DIR="$PROJECT_DIR/.git"
export GIT_WORK_TREE="$PROJECT_DIR"

echo "Working dir: $(pwd)"
echo "GIT_DIR: $GIT_DIR"
echo "GIT_WORK_TREE: $GIT_WORK_TREE"

exec aider \
  --model openai/mistralai/mistral-medium-3.5-128b \
  --openai-api-base https://integrate.api.nvidia.com/v1 \
  --openai-api-key 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 \
  --no-show-model-warnings \
  --subtree-only \
  --yes
