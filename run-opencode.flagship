#!/bin/bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Start an opencode control-agent session in the mpbt workspace root.
# Sets AGENT_ID=Enterprise (the flagship) so this session appears on the
# agent-bus board as "Enterprise".
#

export AGENT_ID="Enterprise"
export STARFLEET_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Register an initial heartbeat on the board. opencode does NOT fire Claude
# Code's SessionStart/SessionEnd hooks, so do it here. No exit cleanup is
# possible (exec replaces this shell) — agent-bus's TTL / prune reaps it.
scripts/agent-bus status idle "flagship opencode session" >/dev/null 2>&1 || true

# Auto-start fleet-watch, monitor-loop, and desktop-notify watcher in
# background (opencode has no Monitor tool). Logs land in _WORK_/agent-bus/logs/
# for later review.
LOGDIR="_WORK_/agent-bus/logs"
mkdir -p "$LOGDIR"
nohup scripts/agent-bus-fleet-watch >> "$LOGDIR/fleet-watch.log" 2>&1 &
nohup scripts/agent-bus-monitor-loop >> "$LOGDIR/monitor-loop.log" 2>&1 &
nohup scripts/agent-bus-watch >> "$LOGDIR/watch.log" 2>&1 &

export OPENCODE_CONFIG_CONTENT="{\"username\":\"${AGENT_ID}\"}"
exec opencode --model "${STARFLEET_MODEL}" --prompt "$(scripts/agent-bus-opencode-boot-prompt)" "$@"
