#
# Start an opencode session for the xserver-25.1 release line.
# Sets XLIBRE_RELEASE so subagents know which solution/workdir to use.
#

. cf/xserver-25.1/config.sh
export XLIBRE_RELEASE

# Distinct agent-bus identity per session (release + PID), unless overridden —
# so this session shows up as its own row on `scripts/agent-bus board`.
: "${AGENT_ID:=${XLIBRE_RELEASE#xserver-}-$$}"
export AGENT_ID

# Register an initial heartbeat on the board. opencode does NOT fire Claude
# Code's SessionStart/SessionEnd hooks, so do it here. No exit cleanup is
# possible (`exec` replaces this shell) — agent-bus's TTL / `prune` reaps it.
scripts/agent-bus status idle "opencode session" >/dev/null 2>&1 || true

# Auto-start monitor-loop and desktop-notify watcher in background
# (opencode has no Monitor tool). Logs land in _WORK_/agent-bus/logs/
# for later review.
LOGDIR="_WORK_/agent-bus/logs"
mkdir -p "$LOGDIR"
nohup scripts/agent-bus-monitor-loop >> "$LOGDIR/monitor-loop.log" 2>&1 &
nohup scripts/starfleetctl agent-bus watch >> "$LOGDIR/watch.log" 2>&1 &

export OPENCODE_CONFIG_CONTENT="{\"username\":\"${AGENT_ID}\"}"
exec opencode --prompt "Session just started for ship ${AGENT_ID:-unknown}. Check your inbox with 'scripts/agent-bus inbox'." "$@"
