### Kernkonzepte

#### 1. TURN OBJECT (zentrales Datenobjekt)
```go
type Turn struct {
    // Request-Info
    RequestID     string
    ShipID        string
    Model         string
    Strategy      string
    Messages      []Message
    Tools         []Tool
    Temperature   float32
    MaxTokens     int
    Stream        bool
    
    // Pipeline-State (wird während Pipeline modifiziert)
    Provider      string           // Gewählter Provider
    Attempt       int              // Aktueller Versuch
    StartTime     time.Time
    Metrics       *TurnMetrics
    Context       context.Context
    
    // Response-Assembly
    StatusCode    int
    Headers       http.Header
    BodyReader    io.Reader        // Finaler Reader für HTTP-Response
    StreamChunks  chan StreamChunk // Für Streaming
    Error         error
}
```

#### 2. PIPELINE STAGE INTERFACE
```go
type PipelineStage interface {
    Name() string
    Process(ctx context.Context, turn *Turn) error
    CanHandle(turn *Turn) bool  // Optional: Stage nur für bestimmte Turns
}

type Pipeline struct {
    stages []PipelineStage
}

func (p *Pipeline) Execute(ctx context.Context, turn *Turn) error {
    for _, stage := range p.stages {
        if !stage.CanHandle(turn) {
            continue
        }
        if err := stage.Process(ctx, turn); err != nil {
            return turn.HandleError(err)  // Kann Fallback triggern
        }
    }
    return nil
}
```

#### 3. PROVIDER ADAPTER INTERFACE (Bottom Layer)
```go
type ProviderAdapter interface {
    Name() string                    // "nim", "zen", "nvidia-direct", ...
    Capabilities() ProviderCapabilities
    
    // Request-Vorbereitung
    PrepareRequest(turn *Turn) (*http.Request, error)
    
    // Response-Handling
    HandleResponse(resp *http.Response, turn *Turn) (io.Reader, error)
    
    // Streaming-spezifisch
    HandleStreamChunk(chunk []byte, turn *Turn) (StreamChunk, error)
    
    // Error-Classification (für Retry/Fallback-Entscheidungen)
    ClassifyError(err error, resp *http.Response) ErrorClass
    
    // Health-Check
    HealthCheck(ctx context.Context) HealthStatus
}

type ErrorClass int
const (
    ErrorClassRetryable    ErrorClass = iota  // Netzwerk, Timeout, 5xx
    ErrorClassRateLimit                        // 429, Quota
    ErrorClassAuthFailed                       // 401, 403
    ErrorClassInvalidRequest                   // 400, Validation
    ErrorClassUpstreamUnavailable              // 503, Connection refused
    ErrorClassFatal                            // Bug, nicht retrybar
)
```

#### 4. RETRY/FALLBACK LAYER (Middleware)
```go
type RetryPolicy struct {
    MaxRetries      int
    BaseDelay       time.Duration
    MaxDelay        time.Duration
    BackoffFactor   float64
    RetryableErrors []ErrorClass
}

func (r *RetryPolicy) Execute(ctx context.Context, turn *Turn, fn func() error) error {
    for attempt := 0; attempt <= r.MaxRetries; attempt++ {
        err := fn()
        if err == nil {
            return nil
        }
        if !r.IsRetryable(err, turn) {
            return err
        }
        if attempt == r.MaxRetries {
            return err
        }
        delay := r.CalculateDelay(attempt)
        select {
        case <-ctx.Done():
            return ctx.Err()
        case <-time.After(delay):
        }
    }
    return nil
}
```

#### 5. STRATEGY LAYER (Routing & Ship-State)
```go
type RoutingStrategy interface {
    Name() string
    SelectProvider(turn *Turn, available []ProviderAdapter) (ProviderAdapter, error)
    OnFailure(turn *Turn, failed ProviderAdapter, err error) (ProviderAdapter, bool)
    UpdateShipState(shipID string, result TurnResult)
}

type ShipState struct {
    ShipID           string
    PreferredModel   string
    LastUsedProvider string
    FailureCount     map[string]int
    LastSuccess      time.Time
    LoadFactor       float64
}
```

#### 6. RESPONSE ASSEMBLY (Pipeline für Streaming)
```go
type ResponseAssembler interface {
    Assemble(turn *Turn) (Response, error)
}

type Response struct {
    StatusCode int
    Headers    http.Header
    Body       io.Reader
    Streaming  bool
    StreamChan chan StreamChunk
}

type StreamChunk struct {
    Type      ChunkType  // Content, Delta, Done, Error
    Data      []byte
    Metadata  map[string]string
}
```

