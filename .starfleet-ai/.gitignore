# Ephemeral runtime directories (not persisted to git)
/comms/
/logs/
/var/
/term-pipes/

# Runtime state files
/DASHBOARD.md

# Built binary (built from src/starfleetctl/)
/bin/starfleetctl

# Launcher scripts (installed by bootstrap)
/bin/run-claude.flagship
/bin/run-claude.ship
/bin/run-opencode.flagship
/bin/run-opencode.ship

# Auto-generated by bootstrap -- do not track
/agents.d/

# Opencode auto-generated (starfleet plugin only)
/.opencode/

# Claude auto-generated
/.claude/

# Starfleetctl source is a separate repo - not tracked here
# (clone starfleetctl repo separately to build)
/src/starfleetctl/
/src/bin/
