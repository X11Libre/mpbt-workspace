#
# Build starfleetctl — runs its Makefile (build + tests) via mpbt's `exec`
# builder. Separate from the xserver build.
#

set -e

. cf/starfleetctl/config.sh

$MPBT -solution "$SOLUTION" -workdir "$WORKDIR" build