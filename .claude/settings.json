{
  "permissions": {
    "allow": [
      "Bash(./starfleet-bootstrap)",
      "Bash(scripts/fetch-all-nvidia-drivers)",
      "Bash(scripts/fetch-all-nvidia-drivers *)",
      "Bash(scripts/fetch-nvidia-drivers)",
      "Bash(scripts/fetch-nvidia-drivers *)",
      "Bash(scripts/list-nvidia-versions)",
      "Bash(scripts/list-nvidia-versions *)",
      "Bash(scripts/nvidia-abi-check)",
      "Bash(scripts/nvidia-abi-check *)",
      "Bash(scripts/nvidia-egl-platforms)",
      "Bash(scripts/nvidia-egl-platforms *)",
      "Bash(scripts/nvidia-undefined-symbols)",
      "Bash(scripts/nvidia-undefined-symbols *)",
      "Bash(meson *)",
      "Bash(ninja *)",
      "Bash(cc *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh issue *)",
      "Bash(.starfleet-ai/bin/starfleetctl)",
      "Bash(.starfleet-ai/bin/starfleetctl *)"
    ]
  },
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
            "command": "MPBT_WORKSPACE_ROOT=\"${MPBT_WORKSPACE_ROOT:-$CLAUDE_PROJECT_DIR}\" \"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl hook claude telemetry 2>/dev/null || true",
          "statusMessage": "confirm-log: telemetry"
        }
      ]
    }
  ]
}
