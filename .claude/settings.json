  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "MPBT_WORKSPACE_ROOT=\"${MPBT_WORKSPACE_ROOT:-$CLAUDE_PROJECT_DIR}\" \"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl hook claude telemetry 2>/dev/null || true",
            "statusMessage": "confirm-log: telemetry"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl agent-bus status idle \"session started\" >/dev/null 2>&1 || true",
            "statusMessage": "agent-bus: heartbeat"
          },
          {
            "type": "command",
            "command": "setsid \"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl agent-bus watch >/dev/null 2>&1 </dev/null & true",
            "statusMessage": "agent-bus: mailbox watcher"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl hook claude monitor-hint 2>/dev/null || true",
            "statusMessage": "agent-bus: monitor hint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl agent-bus clear >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl agent-bus watch --stop >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "[ -n \"$STARFLEET_SHIP_ID\" ] && \"$CLAUDE_PROJECT_DIR\"/.starfleet-ai/bin/starfleetctl ship-names release \"$STARFLEET_SHIP_ID\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/confirm-log-hook 2>/dev/null || true",
            "statusMessage": "confirm-log: telemetry"
          },
          {
            "type": "command",
            "timeout": 120,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-permission-hook",
            "statusMessage": "agent-permission: 1st officer"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf '\ud83d\udd96 %s' \"${STARFLEET_SHIP_ID:-?}\""
  }
}
