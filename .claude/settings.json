  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-bus status idle \"session started\" >/dev/null 2>&1 || true",
            "statusMessage": "agent-bus: heartbeat"
          },
          {
            "type": "command",
            "command": "setsid \"$CLAUDE_PROJECT_DIR\"/scripts/agent-bus-watch >/dev/null 2>&1 </dev/null & true",
            "statusMessage": "agent-bus: mailbox watcher"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-bus clear >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-bus-watch --stop >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
