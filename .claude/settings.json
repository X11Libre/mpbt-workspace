{
  "permissions": {
    "allow": [
      "Bash(scripts/agent-attach)",
      "Bash(scripts/agent-attach *)",
      "Bash(scripts/agent-bus)",
      "Bash(scripts/agent-bus *)",
      "Bash(scripts/agent-run)",
      "Bash(scripts/agent-run *)",
      "Bash(scripts/backport-applies)",
      "Bash(scripts/backport-applies *)",
      "Bash(scripts/backport-commit)",
      "Bash(scripts/backport-commit *)",
      "Bash(scripts/cancel-stale-ci)",
      "Bash(scripts/cancel-stale-ci *)",
      "Bash(scripts/fetch-all-nvidia-drivers)",
      "Bash(scripts/fetch-all-nvidia-drivers *)",
      "Bash(scripts/fetch-nvidia-drivers)",
      "Bash(scripts/fetch-nvidia-drivers *)",
      "Bash(scripts/list-nvidia-versions)",
      "Bash(scripts/list-nvidia-versions *)",
      "Bash(scripts/mk-agent-clone)",
      "Bash(scripts/mk-agent-clone *)",
      "Bash(scripts/nvidia-abi-check)",
      "Bash(scripts/nvidia-abi-check *)",
      "Bash(scripts/nvidia-egl-platforms)",
      "Bash(scripts/nvidia-egl-platforms *)",
      "Bash(scripts/nvidia-undefined-symbols)",
      "Bash(scripts/nvidia-undefined-symbols *)",
      "Bash(scripts/pr-amend-push)",
      "Bash(scripts/pr-amend-push *)",
      "Bash(scripts/pr-checkout)",
      "Bash(scripts/pr-checkout *)",
      "Bash(scripts/pr-claim)",
      "Bash(scripts/pr-claim *)",
      "Bash(scripts/pr-job-logs)",
      "Bash(scripts/pr-job-logs *)",
      "Bash(scripts/pr-set-body)",
      "Bash(scripts/pr-set-body *)",
      "Bash(scripts/prune-stale-ci)",
      "Bash(scripts/prune-stale-ci *)",
      "Bash(scripts/show-branch-file)",
      "Bash(scripts/show-branch-file *)",
      "Bash(scripts/show-pr-conflict)",
      "Bash(scripts/show-pr-conflict *)",
      "Bash(scripts/with-clone-lock)",
      "Bash(scripts/with-clone-lock *)",
      "Bash(scripts/xx-make-pr.sh)",
      "Bash(scripts/xx-make-pr.sh *)",
      "Bash(meson *)",
      "Bash(ninja *)",
      "Bash(cc *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh issue *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-bus status idle \"session started\" >/dev/null 2>&1 || true",
            "statusMessage": "agent-bus: heartbeat"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-bus clear >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
