#!/bin/bash
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright © 2026 Enrico Weigelt, metux IT consult
#
# Start an opencode session for the xserver-25.0 release line.
# Sets XLIBRE_RELEASE so subagents know which solution/workdir to use.
#

. cf/xserver-25.0/config.sh
export XLIBRE_RELEASE

# Distinct agent-bus identity per session (release + PID), unless overridden —
# so this session shows up as its own row on `scripts/agent-bus board`.
: "${AGENT_ID:=${XLIBRE_RELEASE#xserver-}-$$}"
export AGENT_ID

# Register an initial heartbeat on the board. opencode does NOT fire Claude
# Code's SessionStart/SessionEnd hooks, so do it here. No exit cleanup is
# possible (`exec` replaces this shell) — agent-bus's TTL / `prune` reaps it.
scripts/agent-bus status idle "opencode session" >/dev/null 2>&1 || true

exec opencode "$@"
