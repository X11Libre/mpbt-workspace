#
# Optional build of go-x11proto — runs its Makefile (builds the Go tools) via
# mpbt's `exec` builder. Separate from the xserver build.
#

set -e

. cf/go-x11proto/config.sh

$MPBT -solution "$SOLUTION" -workdir "$WORKDIR" build
