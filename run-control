#
# Start a Claude Code control-agent session in the mpbt workspace root.
# Sets AGENT_ID=control so this session appears on the agent-bus board as
# "control" and the /loop Board-Monitor fires agent-bus commands under that
# identity — no XLIBRE_RELEASE (control is cross-project).
#
# Usage:
#   ./run-control [-- <claude args>]
#   ./run-control --detach     start in a detached tmux session (via agent-run)
#

DETACH=0
EXTRA=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --detach|-d) DETACH=1 ;;
        -h|--help)
            sed -n '3,/^DETACH=/p' "$0" | sed 's/^# \{0,1\}//; /^DETACH=/d'
            exit 0 ;;
        --) shift; EXTRA=("$@"); break ;;
        *) EXTRA+=("$1") ;;
    esac
    shift
done

export AGENT_ID="control"
unset XLIBRE_RELEASE 2>/dev/null || true

if [ "$DETACH" -eq 1 ]; then
    # Launch in a named tmux session so it survives terminal close.
    # agent-run registers the AGENT_HANDLE on the board automatically.
    exec scripts/agent-run "" --client claude --name control -- "${EXTRA[@]+"${EXTRA[@]}"}"
fi

# Interactive: register initial heartbeat (Claude Code's SessionStart hook fires
# too, but that uses the env-inherited AGENT_ID=control — belt-and-suspenders).
scripts/agent-bus status idle "control session starting" >/dev/null 2>&1 || true

exec claude "${EXTRA[@]+"${EXTRA[@]}"}"
